From fc8106e5dfa2bdce092e5f17d637fe6ecfb6fade Mon Sep 17 00:00:00 2001
From: Loren Bufanu <loren.bufanu@gmail.com>
Date: Wed, 26 Aug 2026 15:30:25 +0100
Subject: [PATCH] drm/panel: s6e3fc2x01: serialize brightness writes

The panel backlight callback temporarily changes the DSI mode flags before
sending a brightness command. Rapid backlight updates can overlap, which can
interleave DSI writes and leave the mode flags in the wrong state after an
error. Serialize the transaction and restore the original flags on both
success and failure.

This is intentionally limited to the panel backlight transaction; it does
not change brightness values, panel timings, or the default mode.

Signed-off-by: Loren Bufanu <loren.bufanu@gmail.com>

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3fc2x01.c b/drivers/gpu/drm/panel/panel-samsung-s6e3fc2x01.c
index e630802..69a0e24 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e3fc2x01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3fc2x01.c
@@ -7,6 +7,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/regulator/consumer.h>
@@ -27,6 +28,7 @@ struct samsung_s6e3fc2x01 {
 	struct mipi_dsi_device *dsi;
 	struct regulator_bulk_data *supplies;
 	struct gpio_desc *reset_gpio;
+	struct mutex brightness_lock;
 };
 
 static const struct regulator_bulk_data s6e3fc2x01_supplies[] = {
@@ -267,18 +269,21 @@ static const struct drm_panel_funcs samsung_s6e3fc2x01_panel_funcs = {
 static int s6e3fc2x01_panel_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct samsung_s6e3fc2x01 *ctx = mipi_dsi_get_drvdata(dsi);
+	unsigned long mode_flags;
 	u16 brightness = backlight_get_brightness(bl);
 	int err;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mutex_lock(&ctx->brightness_lock);
 
+	mode_flags = dsi->mode_flags;
+	dsi->mode_flags = mode_flags & ~MIPI_DSI_MODE_LPM;
 	err = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (err < 0)
-		return err;
 
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	dsi->mode_flags = mode_flags;
+	mutex_unlock(&ctx->brightness_lock);
 
-	return 0;
+	return err;
 }
 
 static const struct backlight_ops s6e3fc2x01_panel_bl_ops = {
@@ -325,6 +330,8 @@ static int s6e3fc2x01_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset-gpios\n");
 
+	mutex_init(&ctx->brightness_lock);
+
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
-- 
