From c446c8b0d657320e10f6e902a1ff1c5df28cf376 Mon Sep 17 00:00:00 2001
From: OnePlus6T codec build <build@example.invalid>
Date: Fri, 28 Aug 2026 10:10:31 +0100
Subject: [PATCH] fix: preserve Venus input layout and DMA lifetime

---
 common/FormatConverter.cpp                    | 87 +++++++++++++++++--
 .../v4l2_codec2/common/FormatConverter.h      |  9 +-
 components/V4L2EncodeComponent.cpp            | 12 ++-
 .../v4l2_codec2/components/V4L2Encoder.h      |  1 +
 .../v4l2_codec2/components/VideoEncoder.h     |  1 +
 5 files changed, 98 insertions(+), 12 deletions(-)

diff --git a/common/FormatConverter.cpp b/common/FormatConverter.cpp
index d694bd1..0e70159 100644
--- a/common/FormatConverter.cpp
+++ b/common/FormatConverter.cpp
@@ -9,6 +9,7 @@
 
 #include <inttypes.h>
 
+#include <cstring>
 #include <memory>
 #include <string>
 
@@ -50,6 +51,31 @@ void copyPlaneByPixel(const uint8_t* src, int srcStride, int srcColInc, uint8_t*
     }
 }
 
+void fillNV12Padding(uint8_t* dstY, int dstStrideY, uint8_t* dstUV, int dstStrideUV,
+                     const ui::Size& visibleSize, const ui::Size& codedSize) {
+    for (int row = 0; row < visibleSize.height; ++row) {
+        if (dstStrideY > visibleSize.width) {
+            memset(dstY + row * dstStrideY + visibleSize.width, 16,
+                   dstStrideY - visibleSize.width);
+        }
+    }
+    for (int row = visibleSize.height; row < codedSize.height; ++row) {
+        memset(dstY + row * dstStrideY, 16, dstStrideY);
+    }
+
+    const int visibleChromaHeight = (visibleSize.height + 1) / 2;
+    const int codedChromaHeight = (codedSize.height + 1) / 2;
+    for (int row = 0; row < visibleChromaHeight; ++row) {
+        if (dstStrideUV > visibleSize.width) {
+            memset(dstUV + row * dstStrideUV + visibleSize.width, 128,
+                   dstStrideUV - visibleSize.width);
+        }
+    }
+    for (int row = visibleChromaHeight; row < codedChromaHeight; ++row) {
+        memset(dstUV + row * dstStrideUV, 128, dstStrideUV);
+    }
+}
+
 }  // namespace
 
 ImplDefinedToRGBXMap::ImplDefinedToRGBXMap(sp<GraphicBuffer> buf, uint8_t* addr, int rowInc)
@@ -95,14 +121,16 @@ std::unique_ptr<ImplDefinedToRGBXMap> ImplDefinedToRGBXMap::Create(
 std::unique_ptr<FormatConverter> FormatConverter::Create(VideoPixelFormat outFormat,
                                                          const ui::Size& visibleSize,
                                                          uint32_t inputCount,
-                                                         const ui::Size& codedSize) {
+                                                         const ui::Size& codedSize,
+                                                         const VideoFrameLayout& deviceLayout) {
     if (outFormat != VideoPixelFormat::I420 && outFormat != VideoPixelFormat::NV12) {
         ALOGE("Unsupported output format: %d", static_cast<int32_t>(outFormat));
         return nullptr;
     }
 
     std::unique_ptr<FormatConverter> converter(new FormatConverter);
-    if (converter->initialize(outFormat, visibleSize, inputCount, codedSize) != C2_OK) {
+    if (converter->initialize(outFormat, visibleSize, inputCount, codedSize, deviceLayout) !=
+        C2_OK) {
         ALOGE("Failed to initialize FormatConverter");
         return nullptr;
     }
@@ -110,11 +138,25 @@ std::unique_ptr<FormatConverter> FormatConverter::Create(VideoPixelFormat outFor
 }
 
 c2_status_t FormatConverter::initialize(VideoPixelFormat outFormat, const ui::Size& visibleSize,
-                                        uint32_t inputCount, const ui::Size& codedSize) {
+                                        uint32_t inputCount, const ui::Size& codedSize,
+                                        const VideoFrameLayout& deviceLayout) {
     ALOGV("initialize(out_format=%s, visible_size=%dx%d, input_count=%u, coded_size=%dx%d)",
           videoPixelFormatToString(outFormat).c_str(), visibleSize.width, visibleSize.height,
           inputCount, codedSize.width, codedSize.height);
 
+    mDeviceLayout = deviceLayout;
+    mUseDeviceLayout = !deviceLayout.mMultiPlanar && deviceLayout.mPlanes.size() > 1;
+    if (mUseDeviceLayout &&
+        (outFormat != VideoPixelFormat::NV12 || deviceLayout.mFormat != outFormat ||
+         deviceLayout.mPlanes.size() != 2 || deviceLayout.mPlanes[0].mOffset != 0 ||
+         deviceLayout.mPlanes[0].mStride < static_cast<uint32_t>(visibleSize.width) ||
+         deviceLayout.mPlanes[1].mStride < static_cast<uint32_t>(visibleSize.width) ||
+         deviceLayout.mCodedSize.width < visibleSize.width ||
+         deviceLayout.mCodedSize.height < visibleSize.height)) {
+        ALOGE("Unsupported single-buffer device layout");
+        return C2_BAD_VALUE;
+    }
+
     std::shared_ptr<C2BlockPool> pool;
     c2_status_t status = GetCodec2BlockPool(C2BlockPool::BASIC_GRAPHIC, nullptr, &pool);
     if (status != C2_OK) {
@@ -193,10 +235,32 @@ C2ConstGraphicBlock FormatConverter::convertBlock(uint64_t frameIndex,
     uint8_t* dstU = outputView.data()[C2PlanarLayout::PLANE_V];   // only for I420
     uint8_t* dstV = outputView.data()[C2PlanarLayout::PLANE_U];   // only for I420
     uint8_t* dstUV = outputView.data()[C2PlanarLayout::PLANE_U];  // only for NV12
-    const int dstStrideY = outputLayout.planes[C2PlanarLayout::PLANE_Y].rowInc;
+    int dstStrideY = outputLayout.planes[C2PlanarLayout::PLANE_Y].rowInc;
     const int dstStrideU = outputLayout.planes[C2PlanarLayout::PLANE_V].rowInc;   // only for I420
     const int dstStrideV = outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc;   // only for I420
-    const int dstStrideUV = outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc;  // only for NV12
+    int dstStrideUV = outputLayout.planes[C2PlanarLayout::PLANE_U].rowInc;  // only for NV12
+
+    if (mUseDeviceLayout) {
+        const VideoFramePlane& deviceY = mDeviceLayout.mPlanes[0];
+        const VideoFramePlane& deviceUV = mDeviceLayout.mPlanes[1];
+        const size_t outputUVOffset = static_cast<size_t>(dstUV - dstY);
+        const size_t outputCapacity =
+                outputUVOffset + static_cast<size_t>(dstStrideUV) *
+                                         ((outputBlock->height() + 1) / 2);
+        const size_t requiredCapacity =
+                deviceUV.mOffset + static_cast<size_t>(deviceUV.mStride) *
+                                           ((mDeviceLayout.mCodedSize.height + 1) / 2);
+        if (deviceUV.mOffset <
+                    static_cast<size_t>(deviceY.mStride) * mDeviceLayout.mCodedSize.height ||
+            requiredCapacity > outputCapacity) {
+            ALOGE("Single-buffer device layout exceeds the conversion block");
+            *status = C2_NO_MEMORY;
+            return inputBlock;
+        }
+        dstStrideY = static_cast<int>(deviceY.mStride);
+        dstStrideUV = static_cast<int>(deviceUV.mStride);
+        dstUV = dstY + deviceUV.mOffset;
+    }
 
     VideoPixelFormat inputFormat = VideoPixelFormat::UNKNOWN;
     *status = C2_OK;
@@ -213,13 +277,19 @@ C2ConstGraphicBlock FormatConverter::convertBlock(uint64_t frameIndex,
             inputFormat = (srcV > srcU) ? VideoPixelFormat::NV12 : VideoPixelFormat::NV21;
         }
 
-        if (inputFormat == mOutFormat) {
+        if (inputFormat == mOutFormat && !mUseDeviceLayout) {
             ALOGV("Zero-Copy is applied");
             mGraphicBlocks.emplace_back(new BlockEntry(frameIndex));
             return inputBlock;
         }
 
         switch (convertMap(inputFormat, mOutFormat)) {
+        case convertMap(VideoPixelFormat::NV12, VideoPixelFormat::NV12):
+            libyuv::CopyPlane(srcY, srcStrideY, dstY, dstStrideY, mVisibleSize.width,
+                              mVisibleSize.height);
+            libyuv::CopyPlane(srcU, srcStrideU, dstUV, dstStrideUV, mVisibleSize.width,
+                              (mVisibleSize.height + 1) / 2);
+            break;
         case convertMap(VideoPixelFormat::YV12, VideoPixelFormat::I420):
             libyuv::I420Copy(srcY, srcStrideY, srcU, srcStrideU, srcV, srcStrideV, dstY, dstStrideY,
                              dstU, dstStrideU, dstV, dstStrideV, mVisibleSize.width,
@@ -296,6 +366,11 @@ C2ConstGraphicBlock FormatConverter::convertBlock(uint64_t frameIndex,
         return inputBlock;  // This is actually redundant and should not be used.
     }
 
+    if (mUseDeviceLayout) {
+        fillNV12Padding(dstY, dstStrideY, dstUV, dstStrideUV, mVisibleSize,
+                        mDeviceLayout.mCodedSize);
+    }
+
     ALOGV("convertBlock(frame_index=%" PRIu64 ", format=%s)", frameIndex,
           videoPixelFormatToString(inputFormat).c_str());
     entry->mAssociatedFrameIndex = frameIndex;
diff --git a/common/include/v4l2_codec2/common/FormatConverter.h b/common/include/v4l2_codec2/common/FormatConverter.h
index bc3f85a..0ff6769 100644
--- a/common/include/v4l2_codec2/common/FormatConverter.h
+++ b/common/include/v4l2_codec2/common/FormatConverter.h
@@ -13,6 +13,7 @@
 #include <ui/Size.h>
 #include <utils/StrongPointer.h>
 
+#include <v4l2_codec2/common/Common.h>
 #include <v4l2_codec2/common/VideoPixelFormat.h>
 
 namespace android {
@@ -53,7 +54,8 @@ public:
     // initialization error.
     static std::unique_ptr<FormatConverter> Create(VideoPixelFormat outFormat,
                                                    const ui::Size& visibleSize, uint32_t inputCount,
-                                                   const ui::Size& codedSize);
+                                                   const ui::Size& codedSize,
+                                                   const VideoFrameLayout& deviceLayout);
 
     // Convert the input block into the alternative block with required pixel format and return it,
     // or return the original block if zero-copy is applied.
@@ -94,7 +96,8 @@ private:
     // Initialize foramt converter. It will pre-allocate a set of graphic blocks as |codedSize| and
     // |outFormat|. This function should be called prior to other functions.
     c2_status_t initialize(VideoPixelFormat outFormat, const ui::Size& visibleSize,
-                           uint32_t inputCount, const ui::Size& codedSize);
+                           uint32_t inputCount, const ui::Size& codedSize,
+                           const VideoFrameLayout& deviceLayout);
 
     // The array of block entries.
     std::vector<std::unique_ptr<BlockEntry>> mGraphicBlocks;
@@ -108,6 +111,8 @@ private:
 
     VideoPixelFormat mOutFormat = VideoPixelFormat::UNKNOWN;
     ui::Size mVisibleSize;
+    VideoFrameLayout mDeviceLayout;
+    bool mUseDeviceLayout = false;
 };
 
 }  // namespace android
diff --git a/components/V4L2EncodeComponent.cpp b/components/V4L2EncodeComponent.cpp
index e38ee1a..db6d87f 100644
--- a/components/V4L2EncodeComponent.cpp
+++ b/components/V4L2EncodeComponent.cpp
@@ -451,9 +451,11 @@ void V4L2EncodeComponent::stopTask(::base::WaitableEvent* done) {
     // Flushing the encoder will abort all pending work.
     flush();
 
-    mInputFormatConverter.reset();
-
+    // Keep converted input blocks alive until the encoder has completed STREAMOFF,
+    // released its V4L2 buffers and closed the device.  Some stateful encoders can
+    // still access queued DMA buffers while their teardown is in progress.
     mEncoder.reset();
+    mInputFormatConverter.reset();
     mOutputBlockPool.reset();
 
     // Invalidate all weak pointers so no more functions will be executed on the encoder thread.
@@ -674,7 +676,8 @@ bool V4L2EncodeComponent::initializeEncoder() {
           videoPixelFormatToString(mEncoder->inputFormat()).c_str());
     mInputFormatConverter =
             FormatConverter::Create(mEncoder->inputFormat(), mEncoder->visibleSize(),
-                                    V4L2Encoder::kInputBufferCount, mEncoder->codedSize());
+                                    V4L2Encoder::kInputBufferCount, mEncoder->codedSize(),
+                                    mEncoder->inputLayout());
     if (!mInputFormatConverter) {
         ALOGE("Failed to created input format convertor");
         return false;
@@ -804,7 +807,8 @@ void V4L2EncodeComponent::flush() {
     while (!mWorkQueue.empty()) {
         std::unique_ptr<C2Work> work = std::move(mWorkQueue.front());
         // Return buffer to the input format convertor if required.
-        if (mInputFormatConverter && work->input.buffers.empty()) {
+        if (mInputFormatConverter && !work->input.buffers.empty() &&
+            work->input.buffers.front()) {
             mInputFormatConverter->returnBlock(work->input.ordinal.frameIndex.peeku());
         }
         work->result = C2_NOT_FOUND;
diff --git a/components/include/v4l2_codec2/components/V4L2Encoder.h b/components/include/v4l2_codec2/components/V4L2Encoder.h
index d7b55c0..c5e0bcc 100644
--- a/components/include/v4l2_codec2/components/V4L2Encoder.h
+++ b/components/include/v4l2_codec2/components/V4L2Encoder.h
@@ -52,6 +52,7 @@ public:
     VideoPixelFormat inputFormat() const override;
     const ui::Size& visibleSize() const override { return mVisibleSize; }
     const ui::Size& codedSize() const override { return mInputCodedSize; }
+    const VideoFrameLayout& inputLayout() const override { return mInputLayout.value(); }
 
 private:
     // Possible encoder states.
diff --git a/components/include/v4l2_codec2/components/VideoEncoder.h b/components/include/v4l2_codec2/components/VideoEncoder.h
index 5f23541..ad751f7 100644
--- a/components/include/v4l2_codec2/components/VideoEncoder.h
+++ b/components/include/v4l2_codec2/components/VideoEncoder.h
@@ -78,6 +78,7 @@ public:
     virtual VideoPixelFormat inputFormat() const = 0;
     virtual const ui::Size& visibleSize() const = 0;
     virtual const ui::Size& codedSize() const = 0;
+    virtual const VideoFrameLayout& inputLayout() const = 0;
 };
 
 }  // namespace android
-- 
