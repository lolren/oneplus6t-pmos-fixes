diff --git a/src/android/mm/minigbm_buffer.h b/src/android/mm/minigbm_buffer.h
new file mode 100644
index 0000000..5a3e6bc
--- /dev/null
+++ b/src/android/mm/minigbm_buffer.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Copyright 2016 The Chromium OS Authors. All rights reserved.
+ *
+ * Minimal view of the minigbm native handle layout. The layout and magic
+ * value are part of minigbm's cros_gralloc_handle ABI. Keeping this view
+ * local avoids linking the Android camera HAL to minigbm internals.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <hardware/gralloc.h>
+
+namespace libcamera::android {
+
+constexpr unsigned int kMinigbmMaxPlanes = 4;
+constexpr unsigned int kMinigbmMaxFds = kMinigbmMaxPlanes + 1;
+constexpr uint32_t kMinigbmMagic = 0xABCDDCBA;
+
+struct MinigbmBufferHandle : public native_handle_t {
+	int32_t fds[kMinigbmMaxFds];
+	uint32_t strides[kMinigbmMaxPlanes];
+	uint32_t offsets[kMinigbmMaxPlanes];
+	uint32_t sizes[kMinigbmMaxPlanes];
+	uint32_t id;
+	uint32_t width;
+	uint32_t height;
+	uint32_t format;
+	uint32_t tiling;
+	uint64_t formatModifier;
+	uint64_t useFlags;
+	uint32_t magic;
+	uint32_t pixelStride;
+	int32_t droidFormat;
+	int32_t usage;
+	uint32_t numPlanes;
+	uint64_t reservedRegionSize;
+	uint64_t totalSize;
+} __attribute__((packed));
+
+inline const MinigbmBufferHandle *minigbmBufferHandle(buffer_handle_t handle)
+{
+	if (!handle || handle->numFds < 1 || handle->numInts < 0)
+		return nullptr;
+
+	constexpr size_t dataWords =
+		(sizeof(MinigbmBufferHandle) - sizeof(native_handle_t)) /
+		sizeof(int32_t);
+	if (static_cast<size_t>(handle->numFds + handle->numInts) < dataWords)
+		return nullptr;
+
+	const auto *minigbm =
+		reinterpret_cast<const MinigbmBufferHandle *>(handle);
+	if (minigbm->magic != kMinigbmMagic || minigbm->numPlanes == 0 ||
+	    minigbm->numPlanes > kMinigbmMaxPlanes ||
+	    minigbm->numPlanes > static_cast<uint32_t>(handle->numFds))
+		return nullptr;
+
+	return minigbm;
+}
+
+} /* namespace libcamera::android */
