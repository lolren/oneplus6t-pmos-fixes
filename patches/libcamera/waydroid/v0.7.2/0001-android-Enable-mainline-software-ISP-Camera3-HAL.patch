+bool isAndroidContinuousAf(uint8_t mode)
+{
+	return mode == ANDROID_CONTROL_AF_MODE_CONTINUOUS_VIDEO ||
+	       mode == ANDROID_CONTROL_AF_MODE_CONTINUOUS_PICTURE;
+}
+
+uint8_t androidAfState(int32_t state, uint8_t mode)
+{
+	const bool continuous = isAndroidContinuousAf(mode);
+
+	switch (state) {
+	case controls::AfStateScanning:
+		return continuous ? ANDROID_CONTROL_AF_STATE_PASSIVE_SCAN
+				  : ANDROID_CONTROL_AF_STATE_ACTIVE_SCAN;
+	case controls::AfStateFocused:
+		return continuous ? ANDROID_CONTROL_AF_STATE_PASSIVE_FOCUSED
+				  : ANDROID_CONTROL_AF_STATE_FOCUSED_LOCKED;
+	case controls::AfStateFailed:
+		return continuous ? ANDROID_CONTROL_AF_STATE_PASSIVE_UNFOCUSED
+				  : ANDROID_CONTROL_AF_STATE_NOT_FOCUSED_LOCKED;
+	case controls::AfStateIdle:
+	default:
+		return ANDROID_CONTROL_AF_STATE_INACTIVE;
+	}
+}
