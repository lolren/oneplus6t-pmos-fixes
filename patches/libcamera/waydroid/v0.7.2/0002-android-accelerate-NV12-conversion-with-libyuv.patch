From 56deb653b188d4089547278f20771c6d0eadcfc0 Mon Sep 17 00:00:00 2001
From: Lolren <loren.bufanu@gmail.com>
Date: Tue, 25 Aug 2026 10:32:10 +0100
Subject: [PATCH 2/4] android: accelerate NV12 conversion with libyuv

Signed-off-by: Lolren <loren.bufanu@gmail.com>

diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index 5c6cd89..0440dd2 100644
--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -22,6 +22,9 @@
 
 #include <libcamera/formats.h>
 
+#include <libyuv/convert.h>
+#include <libyuv/planar_functions.h>
+
 #include "libcamera/internal/bayer_format.h"
 #include "libcamera/internal/camera_manager.h"
 #include "libcamera/internal/framebuffer.h"
@@ -692,10 +695,13 @@ int DebayerCpu::configure(const StreamConfiguration &inputCfg,
 			 ? (outputCfg.size.width * debayerBpp_ / 8 + 7) & ~7
 			 : outputConfig_.stride;
 
-	if (outputIsNv12_)
+	if (outputIsNv12_) {
 		debayerBuffer_.resize(debayerStride_ * outputCfg.size.height);
-	else
+		chromaBuffer_.resize(outputCfg.size.width * outputCfg.size.height / 2);
+	} else {
 		debayerBuffer_.clear();
+		chromaBuffer_.clear();
+	}
 
 	int ret = setDebayerFunctions(inputCfg.pixelFormat,
 				      outputIsNv12_ ? formats::RGB888
@@ -1165,48 +1171,38 @@ bool DebayerCpu::convertRgbToNv12(Span<const uint8_t> input,
 		uvPlane = output[1].data();
 	}
 
-	const auto clampByte = [](int value) {
-		return static_cast<uint8_t>(std::clamp(value, 0, 255));
-	};
-
-	for (unsigned int y = 0; y < height; ++y) {
-		const uint8_t *src = input.data() + y * debayerStride_;
-		uint8_t *dst = yPlane + y * outputConfig_.stride;
-		for (unsigned int x = 0; x < width; ++x) {
-			const int blue = src[x * 3];
-			const int green = src[x * 3 + 1];
-			const int red = src[x * 3 + 2];
-			dst[x] = clampByte(((66 * red + 129 * green + 25 * blue + 128) >> 8) + 16);
-		}
-		std::fill(dst + width, dst + outputConfig_.stride, 16);
+	const unsigned int chromaStride = width / 2;
+	const unsigned int chromaLength = chromaStride * height / 2;
+	if (chromaBuffer_.size() < chromaLength * 2) {
+		LOG(Debayer, Error) << "NV12 chroma scratch buffer is too small";
+		return false;
 	}
 
-	for (unsigned int y = 0; y < height; y += 2) {
-		const uint8_t *src0 = input.data() + y * debayerStride_;
-		const uint8_t *src1 = src0 + debayerStride_;
-		uint8_t *dst = uvPlane + y / 2 * outputConfig_.stride;
-
-		for (unsigned int x = 0; x < width; x += 2) {
-			int blue = 0;
-			int green = 0;
-			int red = 0;
-			for (unsigned int row = 0; row < 2; ++row) {
-				const uint8_t *src = row ? src1 : src0;
-				for (unsigned int column = 0; column < 2; ++column) {
-					const unsigned int offset = (x + column) * 3;
-					blue += src[offset];
-					green += src[offset + 1];
-					red += src[offset + 2];
-				}
-			}
+	uint8_t *uPlane = chromaBuffer_.data();
+	uint8_t *vPlane = uPlane + chromaLength;
+	int ret = libyuv::RGB24ToI420(input.data(), debayerStride_,
+				       yPlane, outputConfig_.stride,
+				       uPlane, chromaStride,
+				       vPlane, chromaStride,
+				       width, height);
+	if (ret) {
+		LOG(Debayer, Error) << "libyuv RGB24 to I420 conversion failed";
+		return false;
+	}
 
-			blue = (blue + 2) / 4;
-			green = (green + 2) / 4;
-			red = (red + 2) / 4;
-			dst[x] = clampByte(((-38 * red - 74 * green + 112 * blue + 128) >> 8) + 128);
-			dst[x + 1] = clampByte(((112 * red - 94 * green - 18 * blue + 128) >> 8) + 128);
-		}
-		std::fill(dst + width, dst + outputConfig_.stride, 128);
+	libyuv::MergeUVPlane(uPlane, chromaStride,
+			      vPlane, chromaStride,
+			      uvPlane, outputConfig_.stride,
+			      chromaStride, height / 2);
+
+	/* libyuv writes the visible width; initialise any aligned row padding. */
+	if (outputConfig_.stride > width) {
+		for (unsigned int y = 0; y < height; ++y)
+			std::fill(yPlane + y * outputConfig_.stride + width,
+				  yPlane + (y + 1) * outputConfig_.stride, 16);
+		for (unsigned int y = 0; y < height / 2; ++y)
+			std::fill(uvPlane + y * outputConfig_.stride + width,
+				  uvPlane + (y + 1) * outputConfig_.stride, 128);
 	}
 
 	return true;
diff --git a/src/libcamera/software_isp/debayer_cpu.h b/src/libcamera/software_isp/debayer_cpu.h
index 576282b..907b070 100644
--- a/src/libcamera/software_isp/debayer_cpu.h
+++ b/src/libcamera/software_isp/debayer_cpu.h
@@ -156,6 +156,7 @@ private:
 	unsigned int debayerBpp_ = 0;
 	unsigned int debayerStride_ = 0;
 	std::vector<uint8_t> debayerBuffer_;
+	std::vector<uint8_t> chromaBuffer_;
 
 	debayerFn debayer0_;
 	debayerFn debayer1_;
diff --git a/src/libcamera/software_isp/meson.build b/src/libcamera/software_isp/meson.build
index 15f9e40..58625d3 100644
--- a/src/libcamera/software_isp/meson.build
+++ b/src/libcamera/software_isp/meson.build
@@ -27,6 +27,12 @@ libcamera_internal_sources += files([
     'swstats_cpu.cpp',
 ])
 
+# The Android software-ISP extension converts its RGB output to NV12 with
+# libyuv. Android support already makes this dependency mandatory.
+if get_option('android').allowed()
+    libcamera_deps += [libyuv_dep]
+endif
+
 if mesa_works
     config_h.set('HAVE_DEBAYER_EGL', 1)
     libcamera_internal_sources += files([
