From a4a504b53f151224a26bea4e1aaac0c6a2107463 Mon Sep 17 00:00:00 2001
From: Lolren <loren.bufanu@gmail.com>
Date: Tue, 25 Aug 2026 17:24:03 +0100
Subject: [PATCH 3/4] android: add GPU NV12 software ISP path


diff --git a/src/libcamera/egl.cpp b/src/libcamera/egl.cpp
index 7ec7a65..b8b5fb3 100644
--- a/src/libcamera/egl.cpp
+++ b/src/libcamera/egl.cpp
@@ -311,14 +311,21 @@ EGLDisplay eGL::probeDisplay()
 	display = eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA,
 					EGL_DEFAULT_DISPLAY,
 					nullptr);
-
-	if (display == EGL_NO_DISPLAY) {
-		LOG(eGL, Info) << "Unable to get EGL display";
-		return EGL_NO_DISPLAY;
-	}
-
-	if (eglInitialize(display, nullptr, nullptr) != EGL_TRUE) {
-		LOG(eGL, Error) << "eglInitialize fail";
+	if (display != EGL_NO_DISPLAY &&
+	    eglInitialize(display, nullptr, nullptr) == EGL_TRUE)
+		return display;
+
+	/*
+	 * Android's META-EGL does not necessarily expose Mesa's platform enum,
+	 * even when its selected implementation is Mesa and supports a
+	 * surfaceless context. The default display is the portable Android entry
+	 * point; initEGLContext() still creates and binds no surface.
+	 */
+	LOG(eGL, Info) << "Surfaceless platform unavailable, trying default EGL display";
+	display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (display == EGL_NO_DISPLAY ||
+	    eglInitialize(display, nullptr, nullptr) != EGL_TRUE) {
+		LOG(eGL, Error) << "Unable to initialize EGL display";
 		return EGL_NO_DISPLAY;
 	}
 
