-libegl = dependency('egl', required : get_option('softisp-gpu'))
-libglesv2 = dependency('glesv2', required : get_option('softisp-gpu'))
+if get_option('android').allowed()
+    # Android's NDK exposes EGL/GLES as sysroot libraries rather than
+    # pkg-config modules.
+    libegl = cc.find_library('EGL', required : get_option('softisp-gpu'))
+    libglesv2 = cc.find_library('GLESv2', required : get_option('softisp-gpu'))
+else
+    libegl = dependency('egl', required : get_option('softisp-gpu'))
+    libglesv2 = dependency('glesv2', required : get_option('softisp-gpu'))
+endif
 mesa_works = cc.check_header('EGL/egl.h',
                              required : get_option('softisp-gpu'),
                              dependencies : libegl)
