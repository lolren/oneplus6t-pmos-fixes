From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lolren <loren.bufanu@gmail.com>
Date: Tue, 25 Aug 2026 20:04:01 +0100
Subject: [PATCH 6/6] android: reduce large preview source modes

Waydroid commonly requests 1600x1200 private/YUV preview buffers even when
the UI displays a smaller image.  Use a supported, aspect-ratio-preserving
1280-wide source mode and scale into Android's requested buffer, while keeping
JPEG capture at its requested size.

Signed-off-by: Lolren <loren.bufanu@gmail.com>

diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
index f425167..86a9670 100644
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -9,6 +9,7 @@
 
 #include <algorithm>
 #include <cmath>
+#include <cstdint>
 #include <fstream>
 #include <set>
 #include <sys/mman.h>
@@ -41,6 +42,42 @@ LOG_DECLARE_CATEGORY(HAL)
 
 namespace {
 
+/*
+ * The software ISP has to debayer every preview frame before Android can
+ * display it.  Waydroid commonly asks for a 1600x1200 private/YUV stream even
+ * though the UI only displays a much smaller image.  Keep the source stream at
+ * a supported, aspect-ratio-preserving 1280-wide mode and scale the result
+ * into Android's requested buffer.  JPEG streams are deliberately excluded
+ * here and retain their requested source size.
+ */
+Size reducedPreviewSourceSize(const camera3_stream_t *stream,
+				      const Size &requested)
+{
+	if (stream->format != HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED &&
+	    stream->format != HAL_PIXEL_FORMAT_YCBCR_420_888)
+		return requested;
+
+	const Size candidates[] = {
+		{ 1280, 960 },
+		{ 1280, 720 },
+	};
+
+	for (const Size &candidate : candidates) {
+		if (candidate.width >= requested.width ||
+		    candidate.height >= requested.height)
+			continue;
+
+		/* Do not change the field of view or introduce non-uniform scaling. */
+		if (static_cast<uint64_t>(candidate.width) * requested.height !=
+		    static_cast<uint64_t>(candidate.height) * requested.width)
+			continue;
+
+		return candidate;
+	}
+
+	return requested;
+}
+
 /*
  * \struct Camera3StreamConfig
  * \brief Data to store StreamConfiguration associated with camera3_stream(s)
@@ -601,6 +638,7 @@ int CameraDevice::configureStreams(camera3_stream_configuration_t *stream_list)
 	for (unsigned int i = 0; i < stream_list->num_streams; ++i) {
 		camera3_stream_t *stream = stream_list->streams[i];
 		Size size(stream->width, stream->height);
+		Size sourceSize = reducedPreviewSourceSize(stream, size);
 
 		PixelFormat format = capabilities_.toPixelFormat(stream->format);
 
@@ -660,8 +698,8 @@ int CameraDevice::configureStreams(camera3_stream_configuration_t *stream_list)
 		 */
 		auto iter = std::find_if(
 			streamConfigs.begin(), streamConfigs.end(),
-			[&size, &format](const Camera3StreamConfig &streamConfig) {
-				return streamConfig.config.size == size &&
+			[&sourceSize, &format](const Camera3StreamConfig &streamConfig) {
+				return streamConfig.config.size == sourceSize &&
 				       streamConfig.config.pixelFormat == format;
 			});
 		if (iter != streamConfigs.end()) {
@@ -673,8 +711,11 @@ int CameraDevice::configureStreams(camera3_stream_configuration_t *stream_list)
 		}
 
 		Camera3StreamConfig streamConfig;
-		streamConfig.streams = { { stream, CameraStream::Type::Direct } };
-		streamConfig.config.size = size;
+		const CameraStream::Type type = sourceSize == size
+			? CameraStream::Type::Direct
+			: CameraStream::Type::Internal;
+		streamConfig.streams = { { stream, type } };
+		streamConfig.config.size = sourceSize;
 		streamConfig.config.pixelFormat = format;
 		streamConfigs.push_back(std::move(streamConfig));
 	}
@@ -761,7 +802,8 @@ int CameraDevice::configureStreams(camera3_stream_configuration_t *stream_list)
 			 * be used when constructing the subsequent mapped
 			 * streams.
 			 */
-			if (stream.type == CameraStream::Type::Direct)
+			if (stream.type == CameraStream::Type::Direct ||
+			    stream.type == CameraStream::Type::Internal)
 				sourceStream = &streams_.back();
 		}
 	}
