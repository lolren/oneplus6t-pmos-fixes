diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
index a2dc200..5e27856 100644
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -640,6 +640,24 @@ int CameraDevice::configureStreams(camera3_stream_configuration_t *stream_list)
 		Size size(stream->width, stream->height);
 		PixelFormat format = capabilities_.toPixelFormat(stream->format,
 									 stream->usage);
+
+		/*
+		 * A texture-only private stream can be rendered straight into an RGB
+		 * gralloc buffer. In a multi-stream request, however, Android's buffer
+		 * allocation may change when an encoder or JPEG consumer is present.
+		 * The generic Waydroid memory backend cannot propagate that per-buffer
+		 * layout to the software ISP, and importing it as a linear RGB target can
+		 * therefore expose tiled data as horizontal corruption. Keep the fast
+		 * RGB path for isolated previews and use the layout-stable NV12 path when
+		 * more than one stream is configured.
+		 */
+		if (stream_list->num_streams > 1 &&
+		    stream->format == HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED &&
+		    format == formats::XBGR8888) {
+			LOG(HAL, Info)
+				<< "Using NV12 for multi-stream private buffer";
+			format = formats::NV12;
+		}
 		Size sourceSize = reducedPreviewSourceSize(format, size);
 
 		LOG(HAL, Info) << "Stream #" << i
