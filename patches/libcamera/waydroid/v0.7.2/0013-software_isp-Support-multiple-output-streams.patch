+void DebayerCpu::process(uint32_t frame, FrameBuffer *input,
+			 std::vector<Output> outputs,
+			 const DebayerParams &params)
 {
+	if (outputs.size() != 1 || outputs[0].configIndex != 0) {
+		LOG(Debayer, Error)
+			<< "CPU debayer received an unsupported output set";
+		for (const Output &queuedOutput : outputs) {
+			FrameMetadata &metadata = queuedOutput.buffer->_d()->metadata();
+			metadata.status = FrameMetadata::FrameError;
+			outputBufferReady.emit(queuedOutput.buffer);
+		}
+		inputBufferReady.emit(input);
+		return;
+	}
+
+	FrameBuffer *output = outputs[0].buffer;
 	bench_.startFrame();
 
 	Rectangle focusWindow = params.focusWindow.boundedTo(window_);
