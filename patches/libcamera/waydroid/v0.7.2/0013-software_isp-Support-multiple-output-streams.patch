+/**
+ * \brief Pass an input framebuffer and all request outputs to the ISP worker
+ * \param[in] frame The frame number
+ * \param[in] input The input framebuffer
+ * \param[in] outputs The output buffers and their configured stream indexes
+ */
+void SoftwareIsp::process(uint32_t frame, FrameBuffer *input,
+			  std::vector<Output> outputs)
+{
+	std::vector<Debayer::Output> debayerOutputs;
+	debayerOutputs.reserve(outputs.size());
+	for (const Output &output : outputs)
+		debayerOutputs.push_back({ output.buffer, output.configIndex });
+
+	ipa_->computeParams(frame);
+	debayer_->invokeMethod(&Debayer::process,
+			       ConnectionTypeQueued, frame, input,
+			       std::move(debayerOutputs), debayerParams_);
+}
