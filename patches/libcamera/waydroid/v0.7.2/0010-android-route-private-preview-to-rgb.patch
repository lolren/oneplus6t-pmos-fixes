+PixelFormat CameraCapabilities::toPixelFormat(int format, uint64_t usage) const
+{
+	if (format == HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED &&
+	    implementationDefinedRgb_) {
+		constexpr uint64_t yuvUsage =
+			GRALLOC_USAGE_HW_VIDEO_ENCODER |
+			GRALLOC_USAGE_HW_CAMERA_READ |
+			GRALLOC_USAGE_HW_CAMERA_WRITE;
+
+		if (!(usage & yuvUsage))
+			return formats::XBGR8888;
+	}
+
+	return toPixelFormat(format);
+}
