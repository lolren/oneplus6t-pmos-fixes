+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lolren
+ *
+ * Android private RGB stream copy post-processor
+ */
+
+#include "post_processor_rgb.h"
+
+#include <cerrno>
+#include <cstring>
+
+#include <libcamera/base/log.h>
+#include <libcamera/formats.h>
+
+#include "libcamera/internal/mapped_framebuffer.h"
+
+using namespace libcamera;
+
+LOG_DEFINE_CATEGORY(RGB)
+
+int PostProcessorRgb::configure(const StreamConfiguration &inCfg,
+				const StreamConfiguration &outCfg)
+{
+	if (inCfg.pixelFormat != formats::XBGR8888 ||
+	    outCfg.pixelFormat != formats::XBGR8888) {
+		LOG(RGB, Error) << "Unsupported RGB stream format (from "
+				<< inCfg.pixelFormat << " to " << outCfg.pixelFormat
+				<< ")";
+		return -EINVAL;
+	}
+
+	if (inCfg.size != outCfg.size) {
+		LOG(RGB, Error) << "RGB copy cannot scale from " << inCfg.size
+				<< " to " << outCfg.size;
+		return -EINVAL;
+	}
+
+	size_ = inCfg.size;
+	rowBytes_ = static_cast<size_t>(size_.width) * 4;
+	sourceStride_ = inCfg.stride;
+	if (sourceStride_ < rowBytes_) {
+		LOG(RGB, Error) << "RGB source stride is too small: "
+				<< sourceStride_ << " < " << rowBytes_;
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+void PostProcessorRgb::process(
+	Camera3RequestDescriptor::StreamBuffer *streamBuffer)
+{
+	const FrameBuffer &source = *streamBuffer->srcBuffer;
+	CameraBuffer *destination = streamBuffer->dstBuffer.get();
+
+	if (source.planes().size() != 1 || destination->numPlanes() != 1) {
+		LOG(RGB, Error) << "RGB stream does not have one plane";
+		processComplete.emit(streamBuffer, PostProcessor::Status::Error);
+		return;
+	}
+
+	const MappedFrameBuffer sourceMapped(&source, MappedFrameBuffer::MapFlag::Read);
+	if (!sourceMapped.isValid() || sourceMapped.planes().empty()) {
+		LOG(RGB, Error) << "Failed to mmap RGB camera frame buffer";
+		processComplete.emit(streamBuffer, PostProcessor::Status::Error);
+		return;
+	}
+
+	Span<uint8_t> destinationPlane = destination->plane(0);
+	if (destinationPlane.empty()) {
+		LOG(RGB, Error) << "Failed to mmap RGB destination buffer";
+		processComplete.emit(streamBuffer, PostProcessor::Status::Error);
+		return;
+	}
+
+	unsigned int destinationStride = destination->stride(0);
+	if (!destinationStride)
+		destinationStride = static_cast<unsigned int>(rowBytes_);
+	if (destinationStride < rowBytes_ ||
+	    sourceMapped.planes()[0].size() <
+		static_cast<size_t>(sourceStride_) * size_.height ||
+	    destinationPlane.size() <
+		static_cast<size_t>(destinationStride) * size_.height) {
+		LOG(RGB, Error) << "RGB buffer layout is too small";
+		processComplete.emit(streamBuffer, PostProcessor::Status::Error);
+		return;
+	}
+
+	for (unsigned int y = 0; y < size_.height; ++y) {
+		std::memcpy(destinationPlane.data() +
+				    static_cast<size_t>(y) * destinationStride,
+				sourceMapped.planes()[0].data() +
+				    static_cast<size_t>(y) * sourceStride_,
+				rowBytes_);
+	}
+
+	processComplete.emit(streamBuffer, PostProcessor::Status::Success);
+}
