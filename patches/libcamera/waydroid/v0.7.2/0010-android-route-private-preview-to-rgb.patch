+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Lolren
+ *
+ * Android private RGB stream copy post-processor
+ */
+
+#pragma once
+
+#include <cstddef>
+
+#include "../post_processor.h"
+
+#include <libcamera/geometry.h>
+
+class PostProcessorRgb : public PostProcessor
+{
+public:
+	PostProcessorRgb() = default;
+
+	int configure(const libcamera::StreamConfiguration &inCfg,
+		      const libcamera::StreamConfiguration &outCfg) override;
+	void process(Camera3RequestDescriptor::StreamBuffer *streamBuffer) override;
+
+private:
+	libcamera::Size size_;
+	size_t rowBytes_ = 0;
+	unsigned int sourceStride_ = 0;
+};
