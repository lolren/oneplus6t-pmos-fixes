+void DebayerEGL::setNv12ShaderVariableValues(const DebayerParams &params)
+{
+	static const GLfloat vcoordinates[4][2] = {
+		{ -1.0f, -1.0f },
+		{ -1.0f, +1.0f },
+		{ +1.0f, +1.0f },
+		{ +1.0f, -1.0f },
+	};
+	const GLfloat left = static_cast<GLfloat>(displayWindow_.x) / width_;
+	const GLfloat top = static_cast<GLfloat>(displayWindow_.y) / height_;
+	const GLfloat right = static_cast<GLfloat>(displayWindow_.x +
+						   displayWindow_.width) /
+			      width_;
+	const GLfloat bottom = static_cast<GLfloat>(displayWindow_.y +
+						    displayWindow_.height) /
+			       height_;
+	scaleTextureCoordinates_[0][0] = left;
+	scaleTextureCoordinates_[0][1] = top;
+	scaleTextureCoordinates_[1][0] = left;
+	scaleTextureCoordinates_[1][1] = bottom;
+	scaleTextureCoordinates_[2][0] = right;
+	scaleTextureCoordinates_[2][1] = bottom;
+	scaleTextureCoordinates_[3][0] = right;
+	scaleTextureCoordinates_[3][1] = top;
+
+	glEnableVertexAttribArray(nv12AttributeVertex_);
+	glVertexAttribPointer(nv12AttributeVertex_, 2, GL_FLOAT, GL_TRUE,
+			      2 * sizeof(GLfloat), vcoordinates);
+	glEnableVertexAttribArray(nv12AttributeTexture_);
+	glVertexAttribPointer(nv12AttributeTexture_, 2, GL_FLOAT, GL_TRUE,
+			      2 * sizeof(GLfloat), scaleTextureCoordinates_);
+
+	egl_.activateBindTexture(*intermediateImage_);
+	glUniform1i(nv12TextureUniformRgb_,
+		    intermediateImage_->texture_unit_uniform_id_);
+	glUniform4f(nv12SourceRectUniform_, left, top, right - left,
+		    bottom - top);
+	glUniform2f(nv12OutputSizeUniform_, outputSize_.width,
+		    outputSize_.height);
+	glUniform1f(nv12SharpnessUniform_, params.sharpness);
+}
