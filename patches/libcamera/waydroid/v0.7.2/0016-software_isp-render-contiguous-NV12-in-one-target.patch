+bool DebayerEGL::renderNv12Direct(FrameBuffer *output,
+				  const DebayerParams &params)
+{
+	if (nv12DirectDisabled_ || outputSize_.width % 2 ||
+	    outputSize_.height % 2)
+		return false;
+
+	const Span<const FrameBuffer::Plane> planes = output->planes();
+	if (planes.empty())
+		return false;
+
+	const unsigned int yLength = outputConfig_.stride * outputSize_.height;
+	const unsigned int uvLength = yLength / 2;
+	const FrameBuffer::Plane &yPlane = planes[0];
+	const FrameBuffer::Plane &uvPlane = planes.size() > 1 ? planes[1]
+							      : planes[0];
+	const unsigned int yOffset = yPlane.offset;
+	const unsigned int uvOffset = planes.size() > 1
+					      ? uvPlane.offset
+					      : yPlane.offset + yLength;
+
+	if (yPlane.length < yLength ||
+	    (planes.size() > 1 && uvPlane.length < uvLength) ||
+	    (planes.size() == 1 && yPlane.length < yLength + uvLength))
+		return false;
+	struct stat yStatus = {};
+	struct stat uvStatus = {};
+	const bool sameDmaBuf =
+		yPlane.fd == uvPlane.fd ||
+		(fstat(yPlane.fd.get(), &yStatus) == 0 &&
+		 fstat(uvPlane.fd.get(), &uvStatus) == 0 &&
+		 yStatus.st_dev == uvStatus.st_dev &&
+		 yStatus.st_ino == uvStatus.st_ino);
+	if (!sameDmaBuf || uvOffset != yOffset + yLength) {
+		nv12DirectDisabled_ = true;
+		LOG(Debayer, Info)
+			<< "NV12 allocation is not contiguous; using readback conversion";
+		return false;
+	}
+
+	Nv12Target *target = nullptr;
+	for (Nv12Target &cached : nv12TargetCache_) {
+		if (cached.fd == yPlane.fd &&
+		    cached.yOffset == yOffset && cached.uvOffset == uvOffset) {
+			target = &cached;
+			break;
+		}
+	}
+
+	if (!target) {
+		if (nv12TargetCache_.size() >= outputBufferCount_)
+			nv12TargetCache_.pop_front();
+
+		auto image = std::make_unique<eGLImage>(
+			GL_RG, outputSize_.width / 2,
+			outputSize_.height + outputSize_.height / 2,
+			outputConfig_.stride, GL_TEXTURE1, 1,
+			DRM_FORMAT_GR88, yOffset);
+
+		if (egl_.createOutputDMABufTexture2D(*image, yPlane.fd.get())) {
+			nv12DirectDisabled_ = true;
+			nv12TargetCache_.clear();
+			LOG(Debayer, Info)
+				<< "Contiguous NV12 DMA-BUF rendering unavailable; "
+				   "using readback conversion";
+			return false;
+		}
+
+		nv12TargetCache_.push_back({ yPlane.fd, yOffset, uvOffset,
+					     std::move(image) });
+		target = &nv12TargetCache_.back();
+		if (!nv12DirectLogged_) {
+			LOG(Debayer, Info)
+				<< "Rendering contiguous NV12 with one DMA-BUF target: "
+				<< outputSize_ << ", stride " << outputConfig_.stride
+				<< ", planes " << planes.size()
+				<< ", Y offset " << yOffset
+				<< ", UV offset " << uvOffset;
+			nv12DirectLogged_ = true;
+		}
+	}
+
+	egl_.useProgram(nv12ProgramId_);
+	if (egl_.attachTextureToFBO(*target->image)) {
+		nv12DirectDisabled_ = true;
+		nv12TargetCache_.clear();
+		LOG(Debayer, Warning)
+			<< "Contiguous NV12 framebuffer became incomplete; "
+			   "using readback conversion";
+		return false;
+	}
+	setNv12ShaderVariableValues(params);
+	glViewport(0, 0, outputSize_.width / 2,
+		   outputSize_.height + outputSize_.height / 2);
+	glDrawArrays(GL_TRIANGLE_FAN, 0, DEBAYER_OPENGL_COORDS);
+
+	GLenum err = glGetError();
+	if (err != GL_NO_ERROR) {
+		nv12DirectDisabled_ = true;
+		nv12TargetCache_.clear();
+		LOG(Debayer, Warning)
+			<< "Contiguous NV12 rendering failed with GL error " << err
+			<< "; using readback conversion";
+		return false;
+	}
+
+	egl_.flushOutput();
+	return true;
+}
