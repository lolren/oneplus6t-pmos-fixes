index 0000000..73af29e
--- /dev/null
+++ b/src/libcamera/shaders/nv12_contiguous.frag
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Render one complete, linear NV12 allocation through a single GR88 target.
+ * Each framebuffer fragment stores either two adjacent luma bytes or one
+ * interleaved U/V pair.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+uniform sampler2D tex_rgb;
+uniform vec4 source_rect;
+uniform vec2 output_size;
+uniform float sharpness;
+
+float rgbToY(vec3 rgb)
+{
+	return dot(rgb, vec3(0.2578125, 0.50390625, 0.09765625))
+		+ 0.062745098;
+}
+
+void main(void)
+{
+	float row = floor(gl_FragCoord.y);
+
+	if (row < output_size.y) {
+		float sourceY = source_rect.y +
+			((row + 0.5) / output_size.y) * source_rect.w;
+		float pixelStepX = source_rect.z / output_size.x;
+		float pixelStepY = source_rect.w / output_size.y;
+		float x0 = textureOut.x - pixelStepX * 0.5;
+		float x1 = textureOut.x + pixelStepX * 0.5;
+		vec3 rgb0 = texture2D(tex_rgb, vec2(x0, sourceY)).rgb;
+		vec3 rgb1 = texture2D(tex_rgb, vec2(x1, sourceY)).rgb;
+		vec3 blur0 = (rgb0 * 4.0 + rgb1 +
+			texture2D(tex_rgb, vec2(x0 - pixelStepX, sourceY)).rgb +
+			texture2D(tex_rgb, vec2(x0, sourceY - pixelStepY)).rgb +
+			texture2D(tex_rgb, vec2(x0, sourceY + pixelStepY)).rgb) / 8.0;
+		vec3 blur1 = (rgb1 * 4.0 + rgb0 +
+			texture2D(tex_rgb, vec2(x1 + pixelStepX, sourceY)).rgb +
+			texture2D(tex_rgb, vec2(x1, sourceY - pixelStepY)).rgb +
+			texture2D(tex_rgb, vec2(x1, sourceY + pixelStepY)).rgb) / 8.0;
+		rgb0 = clamp(rgb0 + sharpness * (rgb0 - blur0), 0.0, 1.0);
+		rgb1 = clamp(rgb1 + sharpness * (rgb1 - blur1), 0.0, 1.0);
+		gl_FragColor = vec4(clamp(rgbToY(rgb0), 0.0, 1.0),
+					clamp(rgbToY(rgb1), 0.0, 1.0),
+					0.0, 1.0);
+		return;
+	}
+
+	float chromaRow = row - output_size.y;
+	float sourceY = source_rect.y +
+		((chromaRow + 0.5) / (output_size.y * 0.5)) * source_rect.w;
+	vec2 halfStep = source_rect.zw / output_size * 0.5;
+	vec3 rgb = (
+		texture2D(tex_rgb,
+			vec2(textureOut.x - halfStep.x, sourceY - halfStep.y)).rgb +
+		texture2D(tex_rgb,
+			vec2(textureOut.x + halfStep.x, sourceY - halfStep.y)).rgb +
+		texture2D(tex_rgb,
+			vec2(textureOut.x - halfStep.x, sourceY + halfStep.y)).rgb +
+		texture2D(tex_rgb,
+			vec2(textureOut.x + halfStep.x, sourceY + halfStep.y)).rgb) * 0.25;
+	float u = dot(rgb, vec3(-0.1484375, -0.2890625, 0.4375))
+		+ 0.501960784;
+	float v = dot(rgb, vec3(0.4375, -0.3671875, -0.0703125))
+		+ 0.501960784;
+	gl_FragColor = vec4(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0),
+				0.0, 1.0);
+}
