+int DebayerEGL::initNv12Shaders()
+{
+	std::vector<std::string> shaderEnv;
+	GLuint vertexShaderId = 0;
+	GLuint fragmentShaderId = 0;
+
+	egl_.pushEnv(shaderEnv, "#version 100");
+
+	if (egl_.compileVertexShader(vertexShaderId, rgb_scale_vert, shaderEnv)) {
+		LOG(Debayer, Error) << "Compile NV12 vertex shader failed";
+		return -ENODEV;
+	}
+	utils::scope_exit vertexShaderGuard([&] { glDeleteShader(vertexShaderId); });
+
+	if (egl_.compileFragmentShader(fragmentShaderId,
+				       nv12_contiguous_frag, shaderEnv)) {
+		LOG(Debayer, Error) << "Compile contiguous NV12 shader failed";
+		return -ENODEV;
+	}
+	utils::scope_exit fragmentShaderGuard([&] {
+		glDeleteShader(fragmentShaderId);
+	});
+
+	if (egl_.linkProgram(nv12ProgramId_, vertexShaderId,
+			     fragmentShaderId)) {
+		LOG(Debayer, Error) << "Linking contiguous NV12 shader failed";
+		return -ENODEV;
+	}
+
+	nv12AttributeVertex_ = glGetAttribLocation(nv12ProgramId_, "vertexIn");
+	nv12AttributeTexture_ = glGetAttribLocation(nv12ProgramId_, "textureIn");
+	nv12TextureUniformRgb_ = glGetUniformLocation(nv12ProgramId_, "tex_rgb");
+	nv12SourceRectUniform_ =
+		glGetUniformLocation(nv12ProgramId_, "source_rect");
+	nv12OutputSizeUniform_ =
+		glGetUniformLocation(nv12ProgramId_, "output_size");
+	nv12SharpnessUniform_ =
+		glGetUniformLocation(nv12ProgramId_, "sharpness");
+
+	return 0;
+}
