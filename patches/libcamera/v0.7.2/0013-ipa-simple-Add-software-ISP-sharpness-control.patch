diff --git a/src/libcamera/shaders/rgb_scale.frag b/src/libcamera/shaders/rgb_scale.frag
index 758c275..0b401da 100644
--- a/src/libcamera/shaders/rgb_scale.frag
+++ b/src/libcamera/shaders/rgb_scale.frag
@@ -9,10 +9,18 @@ precision highp float;
 
 varying vec2 textureOut;
 uniform sampler2D tex_rgb;
+uniform vec2 texel_step;
+uniform float sharpness;
 
 void main(void)
 {
 	vec4 rgba = texture2D(tex_rgb, textureOut);
+	vec3 blur = (rgba.rgb * 4.0 +
+		texture2D(tex_rgb, textureOut + vec2(texel_step.x, 0.0)).rgb +
+		texture2D(tex_rgb, textureOut - vec2(texel_step.x, 0.0)).rgb +
+		texture2D(tex_rgb, textureOut + vec2(0.0, texel_step.y)).rgb +
+		texture2D(tex_rgb, textureOut - vec2(0.0, texel_step.y)).rgb) / 8.0;
+	rgba.rgb = clamp(rgba.rgb + sharpness * (rgba.rgb - blur), 0.0, 1.0);
 
 #if defined(SWAP_BLUE)
 	gl_FragColor = rgba.bgra;
