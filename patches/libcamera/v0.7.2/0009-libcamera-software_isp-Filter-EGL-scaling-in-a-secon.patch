diff --git a/src/libcamera/shaders/rgb_scale.frag b/src/libcamera/shaders/rgb_scale.frag
new file mode 100644
index 0000000..758c275
--- /dev/null
+++ b/src/libcamera/shaders/rgb_scale.frag
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Filtered RGB scaling pass for the EGL software ISP
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+uniform sampler2D tex_rgb;
+
+void main(void)
+{
+	vec4 rgba = texture2D(tex_rgb, textureOut);
+
+#if defined(SWAP_BLUE)
+	gl_FragColor = rgba.bgra;
+#else
+	gl_FragColor = rgba;
+#endif
+}
diff --git a/src/libcamera/shaders/rgb_scale.vert b/src/libcamera/shaders/rgb_scale.vert
new file mode 100644
index 0000000..8ca2650
--- /dev/null
+++ b/src/libcamera/shaders/rgb_scale.vert
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Vertex shader for the filtered RGB scaling pass
+ */
+
+attribute vec4 vertexIn;
+attribute vec2 textureIn;
+varying vec2 textureOut;
+
+void main(void)
+{
+	gl_Position = vertexIn;
+	textureOut = textureIn;
+}
