 	return 0;
 }
@@ -123,6 +147,9 @@ void Af::queueRequest(IPAContext &context,
 		      const ControlList &requestControls)
 {
 	bool restartContinuous = false;
+	bool resumeContinuous = false;
+	const bool preserveFocusedPosition =
+		state_ == controls::AfStateFocused;
 
 	const auto &mode = requestControls.get(controls::AfMode);
 	if (mode && *mode != mode_) {
@@ -133,8 +160,12 @@ void Af::queueRequest(IPAContext &context,
 		} else {
 			mode_ = *mode;
 			phase_ = ScanPhase::Idle;
-			state_ = controls::AfStateIdle;
-			restartContinuous = mode_ == controls::AfModeContinuous;
+			if (mode_ == controls::AfModeContinuous) {
+				resumeContinuous = preserveFocusedPosition;
