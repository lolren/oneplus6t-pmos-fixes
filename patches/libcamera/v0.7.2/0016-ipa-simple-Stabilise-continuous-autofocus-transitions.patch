 	bool continuous = tuningData["continuous"].get<bool>(true);
 
 	if (configuredMin_ < 0 || configuredMax_ <= configuredMin_ ||
-	    coarseStep_ <= 0 || fineStep_ <= 0 ||
-	    fineStep_ > coarseStep_ || !settleTimeMs_ || !measureTimeMs_ ||
-	    !measureSamples_ || !monitorWindowMs_ || !restartHoldMs_ ||
+	    coarseStep_ <= 0 || fineStep_ <= 0 || fineRange_ <= 0 ||
+	    fineStep_ > coarseStep_ || fineStep_ > fineRange_ ||
+	    configuredInitialPosition_ < configuredMin_ ||
+	    configuredInitialPosition_ > configuredMax_ ||
+	    !settleTimeMs_ || !measureTimeMs_ ||
+	    !measureSamples_ || !fastMeasureSamples_ ||
+	    !monitorWindowMs_ || !restartHoldMs_ ||
 	    focusTolerance_ < 0.0 || focusTolerance_ >= 1.0 ||
-	    restartRatio_ <= 0.0 || restartRatio_ >= 1.0) {
+	    finalFocusTolerance_ < 0.0 || finalFocusTolerance_ >= 1.0 ||
+	    restartRatio_ <= 0.0 || restartRatio_ >= 1.0 ||
+	    monitorReferenceDecay_ <= 0.0 || monitorReferenceDecay_ > 1.0 ||
+	    monitorReferenceRise_ <= 0.0 || monitorReferenceRise_ > 1.0 ||
