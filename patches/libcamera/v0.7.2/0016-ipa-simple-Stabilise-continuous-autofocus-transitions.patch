+			} else {
+				state_ = controls::AfStateIdle;
+			}
 		}
 	}
 
@@ -148,8 +179,17 @@ void Af::queueRequest(IPAContext &context,
 		} else {
 			metering_ = *metering;
 			phase_ = ScanPhase::Idle;
-			state_ = controls::AfStateIdle;
-			restartContinuous = mode_ == controls::AfModeContinuous;
+			if (mode_ == controls::AfModeContinuous &&
+			    metering_ == controls::AfMeteringAuto &&
+			    preserveFocusedPosition) {
+				resumeContinuous = true;
+				restartContinuous = false;
+			} else {
+				state_ = controls::AfStateIdle;
+				restartContinuous =
+					mode_ == controls::AfModeContinuous;
+				resumeContinuous = false;
+			}
 		}
 	}
 
@@ -169,12 +209,15 @@ void Af::queueRequest(IPAContext &context,
 				state_ = controls::AfStateIdle;
 				restartContinuous =
 					mode_ == controls::AfModeContinuous;
+				resumeContinuous = false;
 			}
 		}
 	}
 
 	if (restartContinuous)
-		startScan(context);
+		startScan(context, false);
+	else if (resumeContinuous)
+		resumeContinuousMonitoring();
 
 	const auto &trigger = requestControls.get(controls::AfTrigger);
 	if (!trigger || mode_ != controls::AfModeAuto)
@@ -182,7 +225,7 @@ void Af::queueRequest(IPAContext &context,
 
 	if (*trigger == controls::AfTriggerStart) {
 		if (phase_ == ScanPhase::Idle)
-			startScan(context);
+			startScan(context, true);
 	} else if (*trigger == controls::AfTriggerCancel) {
 		phase_ = ScanPhase::Idle;
 		state_ = controls::AfStateIdle;
@@ -204,21 +247,50 @@ void Af::prepare(IPAContext &context,
 	params->focusWindow = mapped.boundedTo(output);
 }
 
-void Af::buildCoarsePositions()
+void Af::buildCoarsePositions(int32_t center)
 {
 	positions_.clear();
-	positions_.push_back(minPosition_);
-	for (int32_t position = minPosition_ + coarseStep_;
-	     position < maxPosition_; position += coarseStep_)
-		positions_.push_back(position);
-	if (positions_.back() != maxPosition_)
-		positions_.push_back(maxPosition_);
+	positions_.push_back(center);
+
+	const int32_t lower = std::max(minPosition_, center - coarseStep_);
+	const int32_t upper = std::min(maxPosition_, center + coarseStep_);
+	if (lower != center)
+		positions_.push_back(lower);
+	if (upper != center)
+		positions_.push_back(upper);
+}
+
+bool Af::extendCoarsePositions()
+{
+	if (positions_.empty() || positionMetrics_.size() != positions_.size())
+		return false;
+
+	auto best = std::max_element(positionMetrics_.begin(),
+				     positionMetrics_.end());
+	const std::size_t bestIndex = best - positionMetrics_.begin();
+	auto [minimum, maximum] = std::minmax_element(positions_.begin(),
+						      positions_.end());
+	int32_t next;
+
+	if (positions_[bestIndex] == *minimum && *minimum > minPosition_)
+		next = std::max(minPosition_, *minimum - coarseStep_);
+	else if (positions_[bestIndex] == *maximum && *maximum < maxPosition_)
+		next = std::min(maxPosition_, *maximum + coarseStep_);
+	else
+		return false;
+
+	if (std::find(positions_.begin(), positions_.end(), next) !=
+	    positions_.end())
+		return false;
+
+	positions_.push_back(next);
+	return true;
 }
 
 void Af::buildFinePositions()
 {
-	int32_t start = std::max(minPosition_, bestPosition_ - coarseStep_);
-	int32_t end = std::min(maxPosition_, bestPosition_ + coarseStep_);
+	int32_t start = std::max(minPosition_, bestPosition_ - fineRange_);
+	int32_t end = std::min(maxPosition_, bestPosition_ + fineRange_);
 
 	positions_.clear();
 	positions_.push_back(start);
@@ -235,22 +307,30 @@ void Af::buildFinePositions()
 
 void Af::requestPosition(IPAContext &context, int32_t position)
 {
+	const bool moved = position != currentPosition_;
 	currentPosition_ = position;
 	context.activeState.af.lensPosition = position;
 	settleUntil_ = std::chrono::steady_clock::now() +
 		std::chrono::milliseconds(settleTimeMs_);
 	measurementStarted_ = false;
+	settleFramesRemaining_ = moved ? settleFrames_ : 0;
 	samples_ = 0;
 	metricSum_ = 0.0;
 
 	LOG(IPASoftAf, Debug) << "Requesting lens position " << position;
 }
 
-void Af::startScan(IPAContext &context)
+void Af::startScan(IPAContext &context, bool fast)
 {
-	buildCoarsePositions();
+	fastScan_ = fast;
+	/*
+	 * Begin around the last successful position. If the best sample is on
+	 * an edge, extend only in that direction. This keeps ordinary refocus
+	 * local while still allowing the scan to reach the calibrated limits.
+	 */
+	buildCoarsePositions(lastFocusedPosition_);
 	positionIndex_ = 0;
-	bestPosition_ = minPosition_;
+	bestPosition_ = lastFocusedPosition_;
 	bestMetric_ = -std::numeric_limits<double>::infinity();
 	positionMetrics_.clear();
 	phase_ = ScanPhase::Coarse;
@@ -258,9 +338,44 @@ void Af::startScan(IPAContext &context)
 	lowContrast_ = false;
 	monitorMetricSum_ = 0.0;
 	monitorSamples_ = 0;
+	monitorReferenceValid_ = false;
+	monitorReferenceCandidate_ = 0.0;
+	monitorReferenceRiseSamples_ = 0;
 	scanNotBefore_ = std::chrono::steady_clock::now() +
 		std::chrono::milliseconds(firstScan_ ? startupDelayMs_ : 0);
 	requestPosition(context, positions_.front());
+	/* A new metering window also needs the queued pre-window frame flushed. */
+	if (fastScan_)
+		settleFramesRemaining_ = settleFrames_;
+}
+
+void Af::resumeContinuousMonitoring()
+{
+	/*
+	 * A completed tap-focus already left the lens at a measured optimum.
+	 * Returning to whole-frame continuous AF must not throw that result away
+	 * and sweep the full lens. Rebaseline the monitor because its metering
+	 * region may have changed from the tap window to the complete frame.
+	 */
+	phase_ = ScanPhase::Idle;
+	state_ = controls::AfStateFocused;
+	lastFocusedPosition_ = currentPosition_;
+	fastScan_ = false;
+	focusedMetric_ = 0.0;
+	monitorMetricSum_ = 0.0;
+	monitorSamples_ = 0;
+	monitorReferenceValid_ = false;
+	monitorReferenceCandidate_ = 0.0;
+	monitorReferenceRiseSamples_ = 0;
+	lowContrast_ = false;
+	auto now = std::chrono::steady_clock::now();
+	monitorWindowStart_ = now;
+	restartNotBefore_ = now +
+		std::chrono::milliseconds(restartDelayMs_);
+
+	LOG(IPASoftAf, Debug)
+		<< "Resuming continuous autofocus at lens position "
+		<< currentPosition_ << " without a scan";
 }
 
 void Af::selectBestPosition()
@@ -311,6 +422,12 @@ void Af::finishPosition(IPAContext &context, double metric)
 	}
 
 	if (phase_ == ScanPhase::Coarse) {
+		if (extendCoarsePositions()) {
+			positionIndex_ = positions_.size() - 1;
+			requestPosition(context, positions_.back());
+			return;
+		}
+
 		selectBestPosition();
 		buildFinePositions();
 		positionIndex_ = 0;
@@ -347,24 +464,44 @@ void Af::process(IPAContext &context,
 {
 	double metric = focusMetric(stats);
 	auto now = std::chrono::steady_clock::now();
+	const unsigned int activeMeasureTimeMs =
+		fastScan_ ? fastMeasureTimeMs_ : measureTimeMs_;
+	const unsigned int activeMeasureSamples =
+		fastScan_ ? fastMeasureSamples_ : measureSamples_;
 
 	if (metric >= 0.0 && phase_ == ScanPhase::FinalSettle) {
 		if (now >= settleUntil_) {
-			if (!measurementStarted_) {
+			if (settleFramesRemaining_) {
+				settleFramesRemaining_--;
+			} else if (!measurementStarted_) {
 				measurementStarted_ = true;
 				measureUntil_ = now +
-					std::chrono::milliseconds(measureTimeMs_);
+					std::chrono::milliseconds(activeMeasureTimeMs);
+				metricSum_ += metric;
+				samples_++;
+			} else {
+				metricSum_ += metric;
+				samples_++;
 			}
 
-			metricSum_ += metric;
-			samples_++;
-			if (now >= measureUntil_ && samples_ >= measureSamples_) {
+			if (!settleFramesRemaining_ && measurementStarted_ &&
+			    now >= measureUntil_ && samples_ >= activeMeasureSamples) {
 				phase_ = ScanPhase::Idle;
 				focusedMetric_ = metricSum_ / samples_;
+				const double minimumFinalMetric =
+					bestMetric_ * (1.0 - finalFocusTolerance_);
 				state_ = std::isfinite(focusedMetric_) &&
-						 focusedMetric_ > 0.0
+						 focusedMetric_ > 0.0 &&
+						 (!std::isfinite(bestMetric_) ||
+						  focusedMetric_ >= minimumFinalMetric)
 						 ? controls::AfStateFocused
 						 : controls::AfStateFailed;
+				if (state_ == controls::AfStateFocused)
+					lastFocusedPosition_ = currentPosition_;
+				monitorReferenceValid_ =
+					state_ == controls::AfStateFocused;
+				monitorReferenceCandidate_ = 0.0;
+				monitorReferenceRiseSamples_ = 0;
 				restartNotBefore_ = now +
 					std::chrono::milliseconds(restartDelayMs_);
 				monitorWindowStart_ = now;
@@ -382,16 +517,22 @@ void Af::process(IPAContext &context,
 		   (phase_ == ScanPhase::Coarse ||
 		    phase_ == ScanPhase::Fine)) {
 		if (now >= scanNotBefore_ && now >= settleUntil_) {
-			if (!measurementStarted_) {
+			if (settleFramesRemaining_) {
+				settleFramesRemaining_--;
+			} else if (!measurementStarted_) {
 				firstScan_ = false;
 				measurementStarted_ = true;
 				measureUntil_ = now +
-					std::chrono::milliseconds(measureTimeMs_);
+					std::chrono::milliseconds(activeMeasureTimeMs);
+				metricSum_ += metric;
+				samples_++;
+			} else {
+				metricSum_ += metric;
+				samples_++;
 			}
 
-			metricSum_ += metric;
-			samples_++;
-			if (now >= measureUntil_ && samples_ >= measureSamples_)
+			if (!settleFramesRemaining_ && measurementStarted_ &&
+			    now >= measureUntil_ && samples_ >= activeMeasureSamples)
 				finishPosition(context, metricSum_ / samples_);
 		}
 	} else if (metric >= 0.0 &&
@@ -407,28 +548,71 @@ void Af::process(IPAContext &context,
 			monitorMetricSum_ = 0.0;
 			monitorSamples_ = 0;
 
-			LOG(IPASoftAf, Debug)
-				<< "Continuous focus metric " << monitorMetric
-				<< ", reference " << focusedMetric_;
-
-			if (monitorMetric > focusedMetric_)
+			if (!monitorReferenceValid_) {
 				focusedMetric_ = monitorMetric;
+				monitorReferenceValid_ = true;
+				monitorReferenceCandidate_ = 0.0;
+				monitorReferenceRiseSamples_ = 0;
+				lowContrast_ = false;
+				LOG(IPASoftAf, Debug)
+					<< "Continuous focus reference initialized at "
+					<< focusedMetric_;
+			} else {
+				const double previousReference = focusedMetric_;
+				const double restartThreshold =
+					previousReference * restartRatio_;
 
-			if (now >= restartNotBefore_ &&
-			    monitorMetric < focusedMetric_ * restartRatio_) {
-				if (!lowContrast_) {
-					lowContrast_ = true;
-					lowContrastSince_ = now;
-				} else if (now - lowContrastSince_ >=
-					   std::chrono::milliseconds(restartHoldMs_)) {
-					LOG(IPASoftAf, Debug)
-						<< "Restarting continuous autofocus: metric "
-						<< monitorMetric << " fell below "
-						<< focusedMetric_ * restartRatio_;
-					startScan(context);
+				LOG(IPASoftAf, Debug)
+					<< "Continuous focus metric " << monitorMetric
+					<< ", reference " << previousReference;
+
+				if (monitorMetric > previousReference) {
+					/*
+					 * Do not let one noisy high window raise the
+					 * baseline. A later ordinary window must not then
+					 * look like a defocus event.
+					 */
+					if (!monitorReferenceRiseSamples_)
+						monitorReferenceCandidate_ = monitorMetric;
+					else
+						monitorReferenceCandidate_ = std::min(
+							monitorReferenceCandidate_, monitorMetric);
+					monitorReferenceRiseSamples_++;
+					if (monitorReferenceRiseSamples_ >=
+					    monitorReferenceRiseWindows_) {
+						focusedMetric_ = previousReference +
+							(monitorReferenceCandidate_ -
+							 previousReference) *
+							monitorReferenceRise_;
+						monitorReferenceCandidate_ = 0.0;
+						monitorReferenceRiseSamples_ = 0;
+					}
+				} else {
+					monitorReferenceCandidate_ = 0.0;
+					monitorReferenceRiseSamples_ = 0;
+					focusedMetric_ = std::max(
+						monitorMetric,
+						previousReference *
+							monitorReferenceDecay_);
+				}
+
+				if (now >= restartNotBefore_ &&
+				    monitorMetric < restartThreshold) {
+					if (!lowContrast_) {
+						lowContrast_ = true;
+						lowContrastSince_ = now;
+					} else if (now - lowContrastSince_ >=
+						   std::chrono::milliseconds(
+							   restartHoldMs_)) {
+						LOG(IPASoftAf, Debug)
+							<< "Restarting continuous autofocus: metric "
+							<< monitorMetric << " fell below "
+							<< restartThreshold;
+						startScan(context, false);
+					}
+				} else {
+					lowContrast_ = false;
 				}
-			} else {
-				lowContrast_ = false;
 			}
 		}
 	}
