 		LOG(IPASoftAf, Error) << "Invalid autofocus tuning data";
 		return -EINVAL;
 	}
@@ -88,31 +106,39 @@ int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
 			<< lensMin << "-" << lensMax;
 		return -EINVAL;
 	}
+	initialPosition_ = std::clamp(configuredInitialPosition_,
+				      minPosition_, maxPosition_);
 
 	mode_ = defaultMode_;
 	metering_ = controls::AfMeteringAuto;
 	focusWindow_ = {};
 	state_ = controls::AfStateIdle;
 	phase_ = ScanPhase::Idle;
-	currentPosition_ = minPosition_;
-	bestPosition_ = minPosition_;
+	currentPosition_ = initialPosition_;
+	bestPosition_ = initialPosition_;
+	lastFocusedPosition_ = initialPosition_;
 	bestMetric_ = 0.0;
 	positionMetrics_.clear();
 	focusedMetric_ = 0.0;
