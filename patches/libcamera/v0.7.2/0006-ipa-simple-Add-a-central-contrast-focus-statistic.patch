diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index d9d0d9b..24c333c 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -43,6 +43,26 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+	/**
+	 * \brief Sum of squared Sobel gradients in the focus window
+	 *
+	 * A two-dimensional Sobel operator smooths perpendicular to each gradient
+	 * before measuring it. This suppresses sensor noise while retaining image
+	 * detail in both orientations.
+	 */
+	uint64_t focusContrast;
+	/**
+	 * \brief Sum of luminance values in the focus window
+	 */
+	uint64_t focusLuminance;
+	/**
+	 * \brief Number of differences accumulated in focusContrast
+	 */
+	uint32_t focusSamples;
+	/**
+	 * \brief Number of samples accumulated in focusLuminance
+	 */
+	uint32_t focusLuminanceSamples;
 };
 
 } /* namespace libcamera */
