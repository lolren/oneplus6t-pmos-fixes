@@ -79,28 +83,49 @@ public:
 		    y >= (window_.y + window_.height))
 			return;
 
-		(this->*stats2_)(src, stats_[statsBufferIndex]);
+		bool measureFocus = y >= window_.y + window_.height / 4 &&
+				    y < window_.y + window_.height * 3 / 4;
+		(this->*stats2_)(src, stats_[statsBufferIndex],
