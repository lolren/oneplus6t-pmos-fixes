+/**
+ * \brief Specify the area used to calculate focus statistics
+ * \param[in] window Focus window relative to the statistics window
+ *
+ * An empty or invalid window selects the central half of the statistics area.
+ * The colour and luminance statistics continue to cover the full statistics
+ * window, so changing focus metering does not disturb auto exposure or white
+ * balance.
+ */
+void SwStatsCpu::setFocusWindow(const Rectangle &window)
+{
+	Rectangle bounds(window_.size());
+	Rectangle focus = window.boundedTo(bounds);
+
+	if (focus.isNull()) {
+		focus = Rectangle(window_.width / 4, window_.height / 4,
+				  window_.width / 2, window_.height / 2);
+	}
+
+	/* Keep sample coordinates aligned to the Bayer/statistics grid. */
+	focus.x &= ~3;
+	focus.y &= ~(patternSize_.height - 1);
+	focus.width = std::min(focus.width, bounds.width - focus.x);
+	focus.height = std::min(focus.height, bounds.height - focus.y);
+	focus.width &= ~3;
+	focus.height &= ~(patternSize_.height - 1);
+
+	/* A Sobel measurement needs at least three samples in both axes. */
+	if (focus.width < 12 || focus.height < 3 * patternSize_.height) {
+		focus = Rectangle(window_.width / 4, window_.height / 4,
+				  window_.width / 2, window_.height / 2);
+		focus.x &= ~3;
+		focus.y &= ~(patternSize_.height - 1);
+		focus.width &= ~3;
+		focus.height &= ~(patternSize_.height - 1);
+	}
+
+	unsigned int focusLineSize = (focus.width + 3) / 4 + 1;
+	bool storageReady = std::all_of(focusStates_.begin(), focusStates_.end(),
+					[focusLineSize](const FocusState &state) {
+						return std::all_of(state.lines.begin(), state.lines.end(),
+								   [focusLineSize](const std::vector<uint16_t> &line) {
+									   return line.size() == focusLineSize;
+								   });
+					});
+	if (focus == focusWindow_ && storageReady)
+		return;
+
+	focusWindow_ = focus;
 	for (FocusState &state : focusStates_) {
 		for (std::vector<uint16_t> &line : state.lines)
 			line.resize(focusLineSize);
@@ -686,8 +738,8 @@ void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)
 		/* linePointers[0] is not used by any stats0_ functions */
