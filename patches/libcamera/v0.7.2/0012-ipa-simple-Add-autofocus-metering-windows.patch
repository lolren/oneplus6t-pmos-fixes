@@ -115,6 +122,8 @@ void Af::queueRequest(IPAContext &context,
 		      [[maybe_unused]] IPAFrameContext &frameContext,
 		      const ControlList &requestControls)
 {
+	bool restartContinuous = false;
+
 	const auto &mode = requestControls.get(controls::AfMode);
 	if (mode && *mode != mode_) {
 		if (*mode != controls::AfModeAuto &&
@@ -125,11 +134,48 @@ void Af::queueRequest(IPAContext &context,
 			mode_ = *mode;
 			phase_ = ScanPhase::Idle;
 			state_ = controls::AfStateIdle;
-			if (mode_ == controls::AfModeContinuous)
-				startScan(context);
+			restartContinuous = mode_ == controls::AfModeContinuous;
+		}
+	}
+
+	const auto &metering = requestControls.get(controls::AfMetering);
+	if (metering && *metering != metering_) {
+		if (*metering != controls::AfMeteringAuto &&
+		    *metering != controls::AfMeteringWindows) {
+			LOG(IPASoftAf, Warning)
+				<< "Ignoring unsupported autofocus metering mode "
+				<< *metering;
+		} else {
+			metering_ = *metering;
+			phase_ = ScanPhase::Idle;
+			state_ = controls::AfStateIdle;
+			restartContinuous = mode_ == controls::AfModeContinuous;
+		}
+	}
+
+	const auto &windows = requestControls.get(controls::AfWindows);
+	if (windows) {
+		Rectangle selected;
+		for (const Rectangle &window : *windows) {
+			selected = window.boundedTo(context.sensorInfo.analogCrop);
+			if (!selected.isNull())
+				break;
+		}
+
+		if (selected != focusWindow_) {
+			focusWindow_ = selected;
+			if (metering_ == controls::AfMeteringWindows) {
+				phase_ = ScanPhase::Idle;
+				state_ = controls::AfStateIdle;
+				restartContinuous =
+					mode_ == controls::AfModeContinuous;
+			}
 		}
 	}
 
+	if (restartContinuous)
+		startScan(context);
+
 	const auto &trigger = requestControls.get(controls::AfTrigger);
 	if (!trigger || mode_ != controls::AfModeAuto)
 		return;
@@ -143,6 +189,21 @@ void Af::queueRequest(IPAContext &context,
 	}
 }
 
+void Af::prepare(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 DebayerParams *params)
+{
+	params->focusWindow = {};
+	if (metering_ != controls::AfMeteringWindows || focusWindow_.isNull())
+		return;
+
+	const Rectangle output{ context.sensorInfo.outputSize };
+	Rectangle mapped = focusWindow_.transformedBetween(
+		context.sensorInfo.analogCrop, output);
+	params->focusWindow = mapped.boundedTo(output);
+}
