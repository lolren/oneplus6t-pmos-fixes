+++ b/src/libcamera/software_isp/swstats_cpu.cpp
@@ -224,6 +224,10 @@ void SwStatsCpu::finishFocusLine(SwIspStats &stats, FocusState &focusState,
 	sumG += g;                         \
 	sumB += b;                         \
                                            \
+	stats.rgbHistogram[0][static_cast<unsigned int>(r) * SwIspStats::kYHistogramSize / (256 * (div))]++; \
+	stats.rgbHistogram[1][static_cast<unsigned int>(g) * SwIspStats::kYHistogramSize / (256 * (div))]++; \
+	stats.rgbHistogram[2][static_cast<unsigned int>(b) * SwIspStats::kYHistogramSize / (256 * (div))]++; \
+                                           \
 	yVal = r * kRedYMul;               \
 	yVal += g * kGreenYMul;            \
 	yVal += b * kBlueYMul;             \
@@ -451,6 +455,8 @@ void SwStatsCpu::startFrame(uint32_t frame)
 	for (auto &s : stats_) {
 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		s.yHistogram.fill(0);
+		for (auto &histogram : s.rgbHistogram)
+			histogram.fill(0);
 		s.focusContrast = 0;
 		s.focusLuminance = 0;
 		s.focusSamples = 0;
@@ -477,14 +483,20 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
 	if (valid) {
 		sharedStats_->sum_ = RGB<uint64_t>({ 0, 0, 0 });
 		sharedStats_->yHistogram.fill(0);
+		for (auto &histogram : sharedStats_->rgbHistogram)
+			histogram.fill(0);
 		sharedStats_->focusContrast = 0;
 		sharedStats_->focusLuminance = 0;
 		sharedStats_->focusSamples = 0;
 		sharedStats_->focusLuminanceSamples = 0;
 		for (const auto &s : stats_) {
 			sharedStats_->sum_ += s.sum_;
-			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++)
+			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++) {
 				sharedStats_->yHistogram[j] += s.yHistogram[j];
+				for (unsigned int channel = 0; channel < 3; channel++)
+					sharedStats_->rgbHistogram[channel][j] +=
+						s.rgbHistogram[channel][j];
+			}
 			sharedStats_->focusContrast += s.focusContrast;
 			sharedStats_->focusLuminance += s.focusLuminance;
 			sharedStats_->focusSamples += s.focusSamples;
