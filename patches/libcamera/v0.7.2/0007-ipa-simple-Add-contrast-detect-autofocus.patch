+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detect autofocus
+ */
+
+#pragma once
+
+#include <chrono>
+#include <stddef.h>
+#include <stdint.h>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext, const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class ScanPhase {
+		Idle,
+		Coarse,
+		Fine,
+		FinalSettle,
+	};
+
+	void startScan(IPAContext &context);
+	void requestPosition(IPAContext &context, int32_t position);
+	void finishPosition(IPAContext &context, double metric);
+	void selectBestPosition();
+	void buildCoarsePositions();
+	void buildFinePositions();
+	static double focusMetric(const SwIspStats *stats);
+
+	int32_t configuredMin_ = 400;
+	int32_t configuredMax_ = 800;
+	int32_t coarseStep_ = 100;
+	int32_t fineStep_ = 25;
+	unsigned int settleTimeMs_ = 200;
+	unsigned int startupDelayMs_ = 2000;
+	unsigned int measureTimeMs_ = 100;
+	unsigned int measureSamples_ = 2;
+	double focusTolerance_ = 0.03;
+	double restartRatio_ = 0.7;
+	unsigned int monitorWindowMs_ = 250;
+	unsigned int restartHoldMs_ = 1000;
+	unsigned int restartDelayMs_ = 2000;
+	int32_t defaultMode_ = 0;
+
+	int32_t minPosition_ = 0;
+	int32_t maxPosition_ = 0;
+	int32_t mode_ = 0;
+	int32_t state_ = 0;
+	int32_t currentPosition_ = 0;
+	int32_t bestPosition_ = 0;
+	ScanPhase phase_ = ScanPhase::Idle;
+	std::vector<int32_t> positions_;
+	std::vector<double> positionMetrics_;
+	std::size_t positionIndex_ = 0;
+	std::chrono::steady_clock::time_point settleUntil_;
+	std::chrono::steady_clock::time_point measureUntil_;
+	std::chrono::steady_clock::time_point scanNotBefore_;
+	std::chrono::steady_clock::time_point monitorWindowStart_;
+	std::chrono::steady_clock::time_point restartNotBefore_;
+	std::chrono::steady_clock::time_point lowContrastSince_;
+	bool firstScan_ = true;
+	bool measurementStarted_ = false;
+	unsigned int samples_ = 0;
+	double metricSum_ = 0.0;
+	double bestMetric_ = 0.0;
+	double focusedMetric_ = 0.0;
+	double monitorMetricSum_ = 0.0;
+	unsigned int monitorSamples_ = 0;
+	bool lowContrast_ = false;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
