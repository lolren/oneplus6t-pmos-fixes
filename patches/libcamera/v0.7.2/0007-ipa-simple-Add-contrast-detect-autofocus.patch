-		double luminance = static_cast<double>(stats_->focusLuminance) /
-				   stats_->focusLuminanceSamples;
-		double normalized = contrast / std::max(luminance * luminance, 1.0);
-
-		LOG(IPASoft, Debug)
-			<< "Focus contrast " << contrast
-			<< ", mean luminance " << luminance
-			<< ", normalized " << normalized;
-	}
-
 	frameContext.sensor.exposure =
 		sensorControls.get(V4L2_CID_EXPOSURE).get<int32_t>();
 	int32_t again = sensorControls.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
@@ -322,6 +313,7 @@ void IPASoftSimple::processStats(const uint32_t frame,
 	ControlList metadata(controls::controls);
 	for (const auto &algo : algorithms())
 		algo->process(context_, frame, frameContext, stats_, metadata);
+	emitLensControls();
 	metadataReady.emit(frame, metadata);
 
 	/* Sanity check */
@@ -341,6 +333,18 @@ void IPASoftSimple::processStats(const uint32_t frame,
 	setSensorControls.emit(ctrls);
 }
 
+void IPASoftSimple::emitLensControls()
+{
+	auto &position = context_.activeState.af.lensPosition;
+	if (!position || lensInfoMap_.empty())
+		return;
+
+	ControlList ctrls(lensInfoMap_);
+	ctrls.set(V4L2_CID_FOCUS_ABSOLUTE, *position);
+	setLensControls.emit(ctrls);
+	position.reset();
+}
