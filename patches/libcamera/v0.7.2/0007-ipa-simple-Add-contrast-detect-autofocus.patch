diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..cdbab4c
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,383 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detect autofocus
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <errno.h>
+#include <limits>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "simple/ipa_context.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	configuredMin_ = tuningData["minPosition"].get<int32_t>(400);
+	configuredMax_ = tuningData["maxPosition"].get<int32_t>(800);
+	coarseStep_ = tuningData["coarseStep"].get<int32_t>(100);
+	fineStep_ = tuningData["fineStep"].get<int32_t>(25);
+	settleTimeMs_ = tuningData["settleTimeMs"].get<unsigned int>(200);
+	startupDelayMs_ = tuningData["startupDelayMs"].get<unsigned int>(2000);
+	measureTimeMs_ = tuningData["measureTimeMs"].get<unsigned int>(100);
+	measureSamples_ = tuningData["measureSamples"].get<unsigned int>(2);
+	focusTolerance_ =
+		tuningData["focusTolerance"].get<double>(0.03);
+	restartRatio_ = tuningData["restartRatio"].get<double>(0.7);
+	monitorWindowMs_ = tuningData["monitorWindowMs"].get<unsigned int>(250);
+	restartHoldMs_ = tuningData["restartHoldMs"].get<unsigned int>(1000);
+	restartDelayMs_ = tuningData["restartDelayMs"].get<unsigned int>(2000);
+	bool continuous = tuningData["continuous"].get<bool>(true);
+
+	if (configuredMin_ < 0 || configuredMax_ <= configuredMin_ ||
+	    coarseStep_ <= 0 || fineStep_ <= 0 ||
+	    fineStep_ > coarseStep_ || !settleTimeMs_ || !measureTimeMs_ ||
+	    !measureSamples_ || !monitorWindowMs_ || !restartHoldMs_ ||
+	    focusTolerance_ < 0.0 || focusTolerance_ >= 1.0 ||
+	    restartRatio_ <= 0.0 || restartRatio_ >= 1.0) {
+		LOG(IPASoftAf, Error) << "Invalid autofocus tuning data";
+		return -EINVAL;
+	}
+
+	defaultMode_ = continuous ? controls::AfModeContinuous
+				  : controls::AfModeAuto;
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeAuto, controls::AfModeContinuous,
+			    defaultMode_);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto focus = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (focus == configInfo.lensControls.end()) {
+		LOG(IPASoftAf, Error)
+			<< "Autofocus tuning is present but the lens has no focus control";
+		return -EINVAL;
+	}
+
+	int32_t lensMin = focus->second.min().get<int32_t>();
+	int32_t lensMax = focus->second.max().get<int32_t>();
+	minPosition_ = std::clamp(configuredMin_, lensMin, lensMax);
+	maxPosition_ = std::clamp(configuredMax_, lensMin, lensMax);
+	if (minPosition_ >= maxPosition_) {
+		LOG(IPASoftAf, Error)
+			<< "Autofocus range " << configuredMin_ << "-"
+			<< configuredMax_ << " does not overlap lens range "
+			<< lensMin << "-" << lensMax;
+		return -EINVAL;
+	}
+
+	mode_ = defaultMode_;
+	state_ = controls::AfStateIdle;
+	phase_ = ScanPhase::Idle;
+	currentPosition_ = minPosition_;
+	bestPosition_ = minPosition_;
+	bestMetric_ = 0.0;
+	positionMetrics_.clear();
+	focusedMetric_ = 0.0;
+	monitorMetricSum_ = 0.0;
+	monitorSamples_ = 0;
+	lowContrast_ = false;
+	firstScan_ = true;
+
+	if (mode_ == controls::AfModeContinuous)
+		startScan(context);
+	else
+		requestPosition(context, minPosition_);
+
+	LOG(IPASoftAf, Info)
+		<< "Autofocus range " << minPosition_ << "-" << maxPosition_
+		<< ", coarse step " << coarseStep_
+		<< ", fine step " << fineStep_;
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &requestControls)
+{
+	const auto &mode = requestControls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		if (*mode != controls::AfModeAuto &&
+		    *mode != controls::AfModeContinuous) {
+			LOG(IPASoftAf, Warning)
+				<< "Ignoring unsupported autofocus mode " << *mode;
+		} else {
+			mode_ = *mode;
+			phase_ = ScanPhase::Idle;
+			state_ = controls::AfStateIdle;
+			if (mode_ == controls::AfModeContinuous)
+				startScan(context);
+		}
+	}
+
+	const auto &trigger = requestControls.get(controls::AfTrigger);
+	if (!trigger || mode_ != controls::AfModeAuto)
+		return;
+
+	if (*trigger == controls::AfTriggerStart) {
+		if (phase_ == ScanPhase::Idle)
+			startScan(context);
+	} else if (*trigger == controls::AfTriggerCancel) {
+		phase_ = ScanPhase::Idle;
+		state_ = controls::AfStateIdle;
+	}
+}
+
+void Af::buildCoarsePositions()
+{
+	positions_.clear();
+	positions_.push_back(minPosition_);
+	for (int32_t position = minPosition_ + coarseStep_;
+	     position < maxPosition_; position += coarseStep_)
+		positions_.push_back(position);
+	if (positions_.back() != maxPosition_)
+		positions_.push_back(maxPosition_);
+}
+
+void Af::buildFinePositions()
+{
+	int32_t start = std::max(minPosition_, bestPosition_ - coarseStep_);
+	int32_t end = std::min(maxPosition_, bestPosition_ + coarseStep_);
+
+	positions_.clear();
+	positions_.push_back(start);
+	for (int32_t position = start + fineStep_;
+	     position < end; position += fineStep_)
+		positions_.push_back(position);
+	if (positions_.back() != end)
+		positions_.push_back(end);
+	positions_.push_back(bestPosition_);
+	std::sort(positions_.begin(), positions_.end());
+	positions_.erase(std::unique(positions_.begin(), positions_.end()),
+			 positions_.end());
+}
+
+void Af::requestPosition(IPAContext &context, int32_t position)
+{
+	currentPosition_ = position;
+	context.activeState.af.lensPosition = position;
+	settleUntil_ = std::chrono::steady_clock::now() +
+		std::chrono::milliseconds(settleTimeMs_);
+	measurementStarted_ = false;
+	samples_ = 0;
+	metricSum_ = 0.0;
+
+	LOG(IPASoftAf, Debug) << "Requesting lens position " << position;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	buildCoarsePositions();
+	positionIndex_ = 0;
+	bestPosition_ = minPosition_;
+	bestMetric_ = -std::numeric_limits<double>::infinity();
+	positionMetrics_.clear();
+	phase_ = ScanPhase::Coarse;
+	state_ = controls::AfStateScanning;
+	lowContrast_ = false;
+	monitorMetricSum_ = 0.0;
+	monitorSamples_ = 0;
+	scanNotBefore_ = std::chrono::steady_clock::now() +
+		std::chrono::milliseconds(firstScan_ ? startupDelayMs_ : 0);
+	requestPosition(context, positions_.front());
+}
+
+void Af::selectBestPosition()
+{
+	auto maxMetric = std::max_element(positionMetrics_.begin(),
+					  positionMetrics_.end());
+	if (maxMetric == positionMetrics_.end())
+		return;
+
+	bestMetric_ = *maxMetric;
+	double plateauMinimum = bestMetric_ * (1.0 - focusTolerance_);
+	int64_t positionSum = 0;
+	unsigned int plateauSamples = 0;
+
+	for (std::size_t i = 0; i < positionMetrics_.size(); ++i) {
+		if (positionMetrics_[i] < plateauMinimum)
+			continue;
+
+		positionSum += positions_[i];
+		plateauSamples++;
+	}
+
+	if (plateauSamples) {
+		bestPosition_ = std::lround(static_cast<double>(positionSum) /
+					 plateauSamples);
+	} else {
+		bestPosition_ = positions_[maxMetric - positionMetrics_.begin()];
+	}
+
+	LOG(IPASoftAf, Debug)
+		<< "Focus plateau selected lens position " << bestPosition_
+		<< " from " << plateauSamples << " near-peak measurements"
+		<< " (peak metric " << bestMetric_ << ")";
+}
+
+void Af::finishPosition(IPAContext &context, double metric)
+{
+	LOG(IPASoftAf, Debug)
+		<< "Lens position " << currentPosition_
+		<< " focus metric " << metric;
+
+	positionMetrics_.push_back(metric);
+
+	positionIndex_++;
+	if (positionIndex_ < positions_.size()) {
+		requestPosition(context, positions_[positionIndex_]);
+		return;
+	}
+
+	if (phase_ == ScanPhase::Coarse) {
+		selectBestPosition();
+		buildFinePositions();
+		positionIndex_ = 0;
+		bestMetric_ = -std::numeric_limits<double>::infinity();
+		positionMetrics_.clear();
+		phase_ = ScanPhase::Fine;
+		requestPosition(context, positions_.front());
+		return;
+	}
+
+	selectBestPosition();
+	phase_ = ScanPhase::FinalSettle;
+	requestPosition(context, bestPosition_);
+}
+
+double Af::focusMetric(const SwIspStats *stats)
+{
+	if (!stats->valid || !stats->focusSamples ||
+	    !stats->focusLuminanceSamples)
+		return -1.0;
+
+	double contrast = static_cast<double>(stats->focusContrast) /
+			  stats->focusSamples;
+	double luminance = static_cast<double>(stats->focusLuminance) /
+			   stats->focusLuminanceSamples;
+
+	return contrast / std::max(luminance * luminance, 1.0);
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats, ControlList &metadata)
+{
+	double metric = focusMetric(stats);
+	auto now = std::chrono::steady_clock::now();
+
+	if (metric >= 0.0 && phase_ == ScanPhase::FinalSettle) {
+		if (now >= settleUntil_) {
+			if (!measurementStarted_) {
+				measurementStarted_ = true;
+				measureUntil_ = now +
+					std::chrono::milliseconds(measureTimeMs_);
+			}
+
+			metricSum_ += metric;
+			samples_++;
+			if (now >= measureUntil_ && samples_ >= measureSamples_) {
+				phase_ = ScanPhase::Idle;
+				focusedMetric_ = metricSum_ / samples_;
+				state_ = std::isfinite(focusedMetric_) &&
+						 focusedMetric_ > 0.0
+						 ? controls::AfStateFocused
+						 : controls::AfStateFailed;
+				restartNotBefore_ = now +
+					std::chrono::milliseconds(restartDelayMs_);
+				monitorWindowStart_ = now;
+				monitorMetricSum_ = 0.0;
+				monitorSamples_ = 0;
+				lowContrast_ = false;
+
+				LOG(IPASoftAf, Debug)
+					<< "Autofocus settled at lens position "
+					<< currentPosition_ << " with focus metric "
+					<< focusedMetric_;
+			}
+		}
+	} else if (metric >= 0.0 &&
+		   (phase_ == ScanPhase::Coarse ||
+		    phase_ == ScanPhase::Fine)) {
+		if (now >= scanNotBefore_ && now >= settleUntil_) {
+			if (!measurementStarted_) {
+				firstScan_ = false;
+				measurementStarted_ = true;
+				measureUntil_ = now +
+					std::chrono::milliseconds(measureTimeMs_);
+			}
+
+			metricSum_ += metric;
+			samples_++;
+			if (now >= measureUntil_ && samples_ >= measureSamples_)
+				finishPosition(context, metricSum_ / samples_);
+		}
+	} else if (metric >= 0.0 &&
+		   mode_ == controls::AfModeContinuous &&
+		   state_ == controls::AfStateFocused) {
+		monitorMetricSum_ += metric;
+		monitorSamples_++;
+
+		if (now - monitorWindowStart_ >=
+		    std::chrono::milliseconds(monitorWindowMs_)) {
+			double monitorMetric = monitorMetricSum_ / monitorSamples_;
+			monitorWindowStart_ = now;
+			monitorMetricSum_ = 0.0;
+			monitorSamples_ = 0;
+
+			LOG(IPASoftAf, Debug)
+				<< "Continuous focus metric " << monitorMetric
+				<< ", reference " << focusedMetric_;
+
+			if (monitorMetric > focusedMetric_)
+				focusedMetric_ = monitorMetric;
+
+			if (now >= restartNotBefore_ &&
+			    monitorMetric < focusedMetric_ * restartRatio_) {
+				if (!lowContrast_) {
+					lowContrast_ = true;
+					lowContrastSince_ = now;
+				} else if (now - lowContrastSince_ >=
+					   std::chrono::milliseconds(restartHoldMs_)) {
+					LOG(IPASoftAf, Debug)
+						<< "Restarting continuous autofocus: metric "
+						<< monitorMetric << " fell below "
+						<< focusedMetric_ * restartRatio_;
+					startScan(context);
+				}
+			} else {
+				lowContrast_ = false;
+			}
+		}
+	}
+
+	metadata.set(controls::AfMode, mode_);
+	metadata.set(controls::AfState, state_);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
