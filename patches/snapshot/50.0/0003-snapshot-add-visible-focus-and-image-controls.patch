+    fn schedule_focus_reset(&self, generation: u64, serial: u64) {
+        let imp = self.imp();
+        if imp.focus_generation.get() != generation
+            || self.camera().and_then(|camera| camera.target_object()) != Some(serial)
+        {
+            return;
+        }
 
