#!/bin/sh
set -eu

program=${0##*/}

timeout_override=${PMOS_WAYDROID_PROBE_TIMEOUT:-}
control_timeout=${PMOS_WAYDROID_PROBE_CONTROL_TIMEOUT:-45}
camera_id=${PMOS_WAYDROID_PROBE_CAMERA_ID:-}
skip_install=${PMOS_WAYDROID_PROBE_SKIP_INSTALL:-no}
media_output=${PMOS_WAYDROID_PROBE_MEDIA_OUTPUT:-}
allow_encoder=${PMOS_WAYDROID_PROBE_ALLOW_ENCODER:-no}
unfreeze=${PMOS_WAYDROID_PROBE_UNFREEZE:-yes}

usage() {
	printf '%s\n' \
		"usage: $program APK [full|preview|preview-yuv|surface|surface-yuv|record|record-yuv-720p|encode-720p|tap-focus|manual-focus] [OUTPUT_FILE]" \
		'' \
		'Installs and runs the diagnostic Camera2 probe in Waydroid.' \
		'An output file is optional and must not already exist.' \
		'The runner tries to block idle/sleep while the probe is active.' \
		'If the session denies that lock, it continues with an explicit warning.' \
		'Set PMOS_WAYDROID_PROBE_MEDIA_OUTPUT with encode-720p and one camera ID' \
		'to copy the app-private H.264/AAC MP4 to the host.' \
		'encode-720p is phone-gated and also requires PMOS_WAYDROID_PROBE_ALLOW_ENCODER=yes.'
}

die() {
	printf '%s: %s\n' "$program" "$1" >&2
	exit 1
}

if [ "$#" -eq 1 ]; then
	case "$1" in
	-h|--help)
		usage
		exit 0
		;;
	esac
fi

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
	usage >&2
	exit 2
fi

apk=$1
profile=${2:-full}
output=${3:-}

[ -f "$apk" ] || die "APK does not exist: $apk"
case "$profile" in
full|preview|preview-yuv|surface|surface-yuv|record|record-yuv-720p|encode-720p|tap-focus|manual-focus)
	;;
*)
	die "unsupported profile: $profile"
	;;
esac
if [ -n "$timeout_override" ]; then
	timeout_seconds=$timeout_override
elif [ "$profile" = full ]; then
	timeout_seconds=1200
else
	timeout_seconds=480
fi
case "$timeout_seconds" in
''|*[!0-9]*)
	die 'PMOS_WAYDROID_PROBE_TIMEOUT must be a non-negative integer'
	;;
esac
case "$control_timeout" in
''|*[!0-9]*)
	die 'PMOS_WAYDROID_PROBE_CONTROL_TIMEOUT must be a non-negative integer'
	;;
esac
case "$camera_id" in
''|*[!0-9]*)
	[ -z "$camera_id" ] || die 'PMOS_WAYDROID_PROBE_CAMERA_ID must be numeric'
	;;
esac
case "$skip_install" in
yes|no) ;;
*) die 'PMOS_WAYDROID_PROBE_SKIP_INSTALL must be yes or no' ;;
esac
case "$allow_encoder" in
yes|no) ;;
*) die 'PMOS_WAYDROID_PROBE_ALLOW_ENCODER must be yes or no' ;;
esac
case "$unfreeze" in
yes|no) ;;
*) die 'PMOS_WAYDROID_PROBE_UNFREEZE must be yes or no' ;;
esac
[ "$profile" != encode-720p ] || [ "$allow_encoder" = yes ] ||
	die 'encode-720p requires PMOS_WAYDROID_PROBE_ALLOW_ENCODER=yes'
if [ "$profile" = encode-720p ]; then
	[ -n "$camera_id" ] || die 'encode-720p requires PMOS_WAYDROID_PROBE_CAMERA_ID'
	[ "$camera_id" != 1 ] ||
		die 'camera 1 hardware encoding is disabled after a Venus teardown fault'
fi
[ -z "$output" ] || [ ! -e "$output" ] || die "refusing to overwrite: $output"
if [ -n "$media_output" ]; then
	[ "$profile" = encode-720p ] ||
		die 'PMOS_WAYDROID_PROBE_MEDIA_OUTPUT requires profile encode-720p'
	[ -n "$camera_id" ] ||
		die 'PMOS_WAYDROID_PROBE_MEDIA_OUTPUT requires PMOS_WAYDROID_PROBE_CAMERA_ID'
	[ ! -e "$media_output" ] || die "refusing to overwrite: $media_output"
	[ "$media_output" != "$output" ] || die 'result and media output paths must differ'
fi

# A full Camera2 run can take several minutes on the OnePlus 6T software ISP.
# When it is launched over SSH, the phone may otherwise enter suspend and
# Waydroid's configured suspend_action=freeze leaves the next shell call
# blocked. Hold a temporary inhibitor for this invocation only when the
# session permits it; the normal graphical session and battery policy are
# unchanged after the probe exits. Some SSH sessions can enumerate inhibitors
# but cannot create one, so detect that case and continue rather than failing
# before the actual probe starts.
if [ -n "${PMOS_WAYDROID_PROBE_INHIBIT_MARKER:-}" ]; then
	printf '%s\n' started >"$PMOS_WAYDROID_PROBE_INHIBIT_MARKER"
fi
if [ "${PMOS_WAYDROID_PROBE_INHIBITED:-no}" != yes ] &&
	command -v systemd-inhibit >/dev/null 2>&1 &&
	systemd-inhibit --list >/dev/null 2>&1; then
	if inhibit_marker=$(mktemp "${TMPDIR:-/tmp}/oneplus6t-waydroid-probe-inhibit.XXXXXX"); then
		export PMOS_WAYDROID_PROBE_INHIBITED=yes
		export PMOS_WAYDROID_PROBE_INHIBIT_MARKER=$inhibit_marker
		set +e
		systemd-inhibit \
			--what=idle:sleep \
			--mode=block \
			--why='OnePlus 6T Waydroid camera probe is running' \
			"$0" "$@"
		inhibit_rc=$?
		set -e
		child_started=no
		[ -s "$inhibit_marker" ] && child_started=yes
		rm -f -- "$inhibit_marker"
		unset PMOS_WAYDROID_PROBE_INHIBIT_MARKER
		if [ "$child_started" = yes ]; then
			exit "$inhibit_rc"
		fi
		printf '%s\n' \
			"$program: sleep inhibitor unavailable; continuing without it" >&2
	fi
fi

command -v waydroid >/dev/null 2>&1 || die 'waydroid command not found'

if [ "$(id -u 2>/dev/null || printf '1')" != 0 ]; then
	waydroid_shell_check=$(waydroid shell -- true 2>&1) ||
		die "Waydroid shell requires root on this image; rerun with sudo ($waydroid_shell_check)"
fi

waydroid_shell() {
	timeout "$control_timeout" waydroid shell -- "$@"
}

# A stopped graphical session cannot be repaired by the root-side probe. Check
# it before the first shell operation so an SSH invocation fails promptly
# instead of waiting on a shell attached to a torn-down LXC container. Fixture
# implementations may not provide status output; real Waydroid does, so only
# enforce states when the expected status fields are present.
waydroid_status=$(timeout "$control_timeout" waydroid status 2>&1) ||
	die "could not query Waydroid status ($waydroid_status)"
case "$waydroid_status" in
*'Session:'*'STOPPED'*|*'Container:'*'STOPPED'*)
	die 'Waydroid graphical session/container is stopped; start one graphical session before running the probe'
	;;
esac

if [ "$unfreeze" = yes ]; then
	# The supported battery policy freezes an idle Android container. A probe
	# started over SSH must explicitly thaw it before an ImageReader/native
	# window can return buffers; the normal Waydroid launcher does this through
	# its graphical session.
	timeout "$control_timeout" waydroid container unfreeze \
		</dev/null >/dev/null 2>&1 || :
	waydroid_status=$(timeout "$control_timeout" waydroid status 2>&1) ||
		die "could not verify Waydroid after thaw ($waydroid_status)"
	case "$waydroid_status" in
	*'Session:'*'STOPPED'*|*'Container:'*'STOPPED'*)
		die 'Waydroid stopped while the probe was being prepared'
		;;
	*'Container:'*'FROZEN'*)
		die 'Waydroid container remained frozen after the bounded thaw'
		;;
	esac
fi

if [ "$skip_install" = no ]; then
	apk_bytes=$(wc -c <"$apk" | tr -d ' ')
	[ "$apk_bytes" -gt 0 ] || die "APK is empty: $apk"
	waydroid_shell pm install -r -S "$apk_bytes" <"$apk"
else
	waydroid_shell pm path dev.lolren.waydroidcameraprobe >/dev/null ||
		die 'probe package is not installed in Waydroid'
fi
waydroid_shell pm grant dev.lolren.waydroidcameraprobe android.permission.CAMERA \
	2>/dev/null || :
waydroid_shell pm grant dev.lolren.waydroidcameraprobe android.permission.RECORD_AUDIO \
	2>/dev/null || :
waydroid_shell am force-stop \
	dev.lolren.waydroidcameraprobe </dev/null >/dev/null 2>&1 || :
waydroid_shell rm -f \
	/data/user/0/dev.lolren.waydroidcameraprobe/files/result.txt \
	2>/dev/null || :
if [ "$profile" = encode-720p ] && [ -n "$camera_id" ]; then
	waydroid_shell rm -f \
		"/data/user/0/dev.lolren.waydroidcameraprobe/files/encoded-camera-$camera_id.mp4" \
		2>/dev/null || :
fi
if [ -n "$camera_id" ]; then
	waydroid_shell am start -W -n \
		dev.lolren.waydroidcameraprobe/.CameraProbeActivity \
		--es profile "$profile" --es camera-id "$camera_id"
else
	waydroid_shell am start -W -n \
		dev.lolren.waydroidcameraprobe/.CameraProbeActivity \
		--es profile "$profile"
fi

result=''
elapsed=0
while [ "$elapsed" -le "$timeout_seconds" ]; do
	result=$(waydroid_shell cat \
		/data/user/0/dev.lolren.waydroidcameraprobe/files/result.txt \
		2>/dev/null || :)
	case "$result" in
	*PROBE_DONE*)
		if [ -n "$media_output" ]; then
			mkdir -p "$(dirname -- "$media_output")"
			media_tmp=$(mktemp "${TMPDIR:-/tmp}/waydroid-camera-media.XXXXXX")
			if ! waydroid_shell cat \
				"/data/user/0/dev.lolren.waydroidcameraprobe/files/encoded-camera-$camera_id.mp4" \
				>"$media_tmp"; then
				rm -f -- "$media_tmp"
				die 'could not copy encoded media from Waydroid'
			fi
			if [ ! -s "$media_tmp" ]; then
				rm -f -- "$media_tmp"
				die 'encoded media copied from Waydroid was empty'
			fi
			mv -- "$media_tmp" "$media_output"
			printf 'media: %s\n' "$media_output"
		fi
		if [ -n "$output" ]; then
			mkdir -p "$(dirname -- "$output")"
			printf '%s\n' "$result" > "$output"
			printf 'result: %s\n' "$output"
		else
			printf '%s\n' "$result"
		fi
		exit 0
		;;
	esac
	if [ "$elapsed" -eq "$timeout_seconds" ]; then
		break
	fi
	sleep 1
	elapsed=$((elapsed + 1))
done

die "probe did not finish within ${timeout_seconds}s"
