#!/bin/sh
set -eu

PROGRAM=${0##*/}
waydroid_cmd=${PMOS_WAYDROID_GAPPS_WAYDROID:-waydroid}
timeout_seconds=${PMOS_WAYDROID_GAPPS_TIMEOUT:-10}
output=${PMOS_WAYDROID_GAPPS_OUTPUT:-}
problems=0

usage() {
	cat <<EOF
Usage: $PROGRAM [--output FILE]

Read-only check for the Android packages that make a Waydroid GAPPS image
usable for Google Play services and the Play Store. It never initializes,
stops, starts or modifies Waydroid.
EOF
}

die() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
	exit 1
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--output)
		[ "$#" -ge 2 ] || die '--output requires a file'
		output=$2
		shift 2
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		printf '%s: unknown argument: %s\n' "$PROGRAM" "$1" >&2
		usage >&2
		exit 2
		;;
	esac
done

case "$timeout_seconds" in
''|*[!0-9]*)
	die 'PMOS_WAYDROID_GAPPS_TIMEOUT must be a positive integer'
	;;
esac
[ "$timeout_seconds" -gt 0 ] ||
	die 'PMOS_WAYDROID_GAPPS_TIMEOUT must be a positive integer'

if [ -n "$output" ]; then
	[ ! -e "$output" ] || die "refusing to overwrite: $output"
	mkdir -p "$(dirname -- "$output")"
	exec >"$output"
fi

command -v "$waydroid_cmd" >/dev/null 2>&1 ||
	die "Waydroid command not found: $waydroid_cmd"

run_waydroid() {
	if command -v timeout >/dev/null 2>&1; then
		timeout "$timeout_seconds" "$waydroid_cmd" "$@"
	else
		"$waydroid_cmd" "$@"
	fi
}

printf 'report=oneplus6t-waydroid-gapps\n'
printf 'waydroid_command=%s\n' "$waydroid_cmd"
printf 'timeout_seconds=%s\n' "$timeout_seconds"
if command -v timeout >/dev/null 2>&1; then
	printf '%s\n' 'timeout_support=available'
else
	printf '%s\n' 'timeout_support=unavailable (command may not be bounded)'
fi

status_output=''
status_exit=0
if status_output=$(run_waydroid status 2>&1); then
	:
else
	status_exit=$?
fi
printf 'status_exit=%s\n' "$status_exit"
if [ -n "$status_output" ]; then
	printf '%s\n' 'status_output_begin'
	printf '%s\n' "$status_output"
	printf '%s\n' 'status_output_end'
else
	printf '%s\n' 'status_output=unavailable'
fi

read_property() {
	label=$1
	property=$2
	value=$(run_waydroid shell getprop "$property" 2>/dev/null || true)
	if [ -n "$value" ]; then
		printf '%s=%s\n' "$label" "$value"
	else
		printf '%s=unavailable\n' "$label"
	fi
}

read_property android_release ro.build.version.release
read_property android_abis ro.product.cpu.abilist

check_package() {
	label=$1
	package=$2
	paths=$(run_waydroid shell pm path "$package" 2>/dev/null || true)
	if printf '%s\n' "$paths" | grep -q '^package:'; then
		printf '%s=present\n' "$label"
	else
		printf '%s=missing\n' "$label"
		problems=$((problems + 1))
	fi
	if [ -n "$paths" ]; then
		printf '%s_paths_begin\n' "$label"
		printf '%s\n' "$paths"
		printf '%s_paths_end\n' "$label"
	fi
}

check_package gms com.google.android.gms
check_package gsf com.google.android.gsf
check_package play_store com.android.vending

if [ "$problems" -eq 0 ]; then
	printf '%s\n' 'gapps=verified'
	exit 0
fi

printf '%s\n' 'gapps=not-verified'
exit 1
