#!/bin/sh
set -eu

while [ "$#" -gt 0 ]; do
	case "$1" in
	--keys-dir|--root|--arch|--repository)
		shift 2
		;;
	--no-network|--no-interactive)
		shift
		;;
	*)
		break
		;;
	esac
done

command_name=${1:?missing apk command}
shift

case "$command_name" in
search)
	[ "${PMOS_MOCK_INDEX_SIGNATURE_FAILURE:-no}" = no ] || exit 1
	printf '%s\n' 'advanced-snapshot-0.1.0-r1'
	;;
verify)
	[ "${PMOS_MOCK_SIGNATURE_FAILURE:-no}" = no ] || exit 1
	case "$1" in
	*/APKINDEX.tar.gz)
		[ "${PMOS_MOCK_INDEX_SIGNATURE_FAILURE:-no}" = no ] || exit 1
		;;
	esac
	printf '%s: OK\n' "$1"
	;;
list)
	[ "$1" = --installed ]
	package=$2
	version=$(awk -F '|' -v wanted="$package" \
		'$1 == wanted { print $2; exit }' "$PMOS_MOCK_PACKAGE_STATE")
	[ -n "$version" ] || exit 0
	printf '%s-%s aarch64 {mock} (MIT) [installed]\n' "$package" "$version"
	;;
add)
	for argument in "$@"; do
		if [ "$argument" = --initdb ]; then
			printf '%s\n' 'OK: mock initdb'
			exit 0
		fi
	done
	candidate_pipewire=${PMOS_MOCK_CANDIDATE_PIPEWIRE_VERSION:-1.6.8-r7}
	rollback_pipewire=${PMOS_MOCK_ROLLBACK_PIPEWIRE_VERSION:-1.6.8-r6}
	candidate_app=${PMOS_MOCK_CANDIDATE_APP_VERSION:-0.1.0-r1}
	rollback_app=${PMOS_MOCK_ROLLBACK_APP_VERSION:-0.1.0-r0}
	candidate_lang=${PMOS_MOCK_CANDIDATE_LANG_VERSION:-0.1.0-r1}
	rollback_lang=${PMOS_MOCK_ROLLBACK_LANG_VERSION:-0.1.0-r0}
	simulate=no
	target=
	for argument in "$@"; do
		case "$argument" in
		--simulate) simulate=yes ;;
		*advanced-snapshot-"$candidate_app".apk) target=candidate ;;
		*advanced-snapshot-"$rollback_app".apk) target=rollback ;;
		esac
	done
	[ -n "$target" ] || { printf '%s\n' 'mock could not select target' >&2; exit 1; }
	if [ "$target" = candidate ]; then
		action=Upgrading
		from_pipewire=$rollback_pipewire
		to_pipewire=$candidate_pipewire
		from_app=$rollback_app
		to_app=$candidate_app
		from_lang=$rollback_lang
		to_lang=$candidate_lang
	else
		action=Downgrading
		from_pipewire=$candidate_pipewire
		to_pipewire=$rollback_pipewire
		from_app=$candidate_app
		to_app=$rollback_app
		from_lang=$candidate_lang
		to_lang=$rollback_lang
	fi
	operation_count=0
	[ "$from_pipewire" = "$to_pipewire" ] || operation_count=$((operation_count + 1))
	[ "$from_app" = "$to_app" ] || operation_count=$((operation_count + 1))
	[ "$from_lang" = "$to_lang" ] || operation_count=$((operation_count + 1))
	operation_index=0
	if [ "$from_pipewire" != "$to_pipewire" ]; then
		operation_index=$((operation_index + 1))
		printf '(%s/%s) %s pipewire-spa-libcamera (%s -> %s)\n' \
			"$operation_index" "$operation_count" "$action" \
			"$from_pipewire" "$to_pipewire"
	fi
	if [ "$from_app" != "$to_app" ]; then
		operation_index=$((operation_index + 1))
		printf '(%s/%s) %s advanced-snapshot (%s -> %s)\n' \
			"$operation_index" "$operation_count" "$action" "$from_app" "$to_app"
	fi
	if [ "$from_lang" != "$to_lang" ]; then
		operation_index=$((operation_index + 1))
		printf '(%s/%s) %s advanced-snapshot-lang (%s -> %s)\n' \
			"$operation_index" "$operation_count" "$action" "$from_lang" "$to_lang"
	fi
	if [ "${PMOS_MOCK_UNEXPECTED_OPERATION:-no}" = yes ]; then
		printf '(4/4) Removing unrelated-package (1-r0)\n'
	fi
	printf '%s\n' 'OK: mock transaction'
	if [ "$simulate" = yes ] && [ "${PMOS_MOCK_MUTATE_INDEX:-no}" = yes ]; then
		printf '%s\n' changed >>"$PMOS_MOCK_INDEX"
	fi
	[ "$simulate" = no ] || exit 0
	state_tmp=$PMOS_MOCK_PACKAGE_STATE.tmp
	world_tmp=$PMOS_MOCK_WORLD.tmp
	if [ "$target" = candidate ]; then
		printf '%s\n' \
			"pipewire-spa-libcamera|$candidate_pipewire" \
			"advanced-snapshot|$candidate_app" \
			"advanced-snapshot-lang|$candidate_lang" >"$state_tmp"
		awk '$0 !~ /^advanced-snapshot(-lang)?($|[<>=~])/ && \
			$0 !~ /^pipewire-spa-libcamera($|[<>=~])/' \
			"$PMOS_MOCK_WORLD" >"$world_tmp"
		printf '%s\n' \
			"advanced-snapshot><mock-${candidate_app##*-}" \
			"advanced-snapshot-lang><mock-${candidate_lang##*-}-lang" >>"$world_tmp"
	else
		printf '%s\n' \
			"pipewire-spa-libcamera|$rollback_pipewire" \
			"advanced-snapshot|$rollback_app" \
			"advanced-snapshot-lang|$rollback_lang" >"$state_tmp"
		awk '$0 !~ /^advanced-snapshot(-lang)?($|[<>=~])/ && \
			$0 !~ /^pipewire-spa-libcamera($|[<>=~])/' \
			"$PMOS_MOCK_WORLD" >"$world_tmp"
		printf '%s\n' \
			"advanced-snapshot><mock-${rollback_app##*-}" \
			"advanced-snapshot-lang><mock-${rollback_lang##*-}-lang" >>"$world_tmp"
		if [ "$candidate_pipewire" != "$rollback_pipewire" ]; then
			printf '%s\n' "pipewire-spa-libcamera><mock-${rollback_pipewire##*-}" \
				>>"$world_tmp"
		fi
	fi
	sort -o "$world_tmp" "$world_tmp"
	mv "$state_tmp" "$PMOS_MOCK_PACKAGE_STATE"
	mv "$world_tmp" "$PMOS_MOCK_WORLD"
	;;
info)
	[ "$1" = -r ] && [ "$2" = pipewire-spa-libcamera ]
	printf '%s\n' \
		'pipewire-spa-libcamera is required by:' \
		'postmarketos-ui-phosh' \
		'advanced-snapshot' \
		'snapshot'
	;;
del)
	simulate=no
	for argument in "$@"; do
		[ "$argument" != --simulate ] || simulate=yes
	done
	printf '%s\n' \
		'World updated, but the following packages are not removed due to:' \
		'  pipewire-spa-libcamera: postmarketos-ui-phosh advanced-snapshot snapshot' \
		'' \
		'OK: mock transaction'
	[ "$simulate" = yes ] && exit 0
	world_tmp=$PMOS_MOCK_WORLD.tmp
	awk '$0 !~ /^pipewire-spa-libcamera($|[<>=~])/' \
		"$PMOS_MOCK_WORLD" >"$world_tmp"
	mv "$world_tmp" "$PMOS_MOCK_WORLD"
	;;
*)
	printf 'unsupported mock apk command: %s\n' "$command_name" >&2
	exit 1
	;;
esac
