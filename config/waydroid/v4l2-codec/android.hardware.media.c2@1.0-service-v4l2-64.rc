# Qualcomm Venus V4L2 Codec2 service for the OnePlus 6/6T Waydroid image.
# The software Codec2 store remains available as the separate "software"
# instance, while this service registers the hardware-backed "default" store.
service android-hardware-media-c2-v4l2-hal-1-0 /system/bin/hw/android.hardware.media.c2@1.0-service-v4l2-64
    interface android.hardware.media.c2@1.0::IComponentStore default
    class hal
    user media
    group camera mediadrm drmrpc
    ioprio rt 4
    task_profiles ProcessCapacityHigh
    setenv MESA_GLSL_CACHE_DISABLE 1
