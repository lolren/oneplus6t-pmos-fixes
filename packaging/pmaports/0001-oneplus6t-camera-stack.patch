+@@ -0,0 +1,14 @@
++/* SPDX-License-Identifier: LGPL-2.1-or-later */
++/*
++ * Vertex shader for the filtered RGB scaling pass
++ */
++
++attribute vec4 vertexIn;
++attribute vec2 textureIn;
++varying vec2 textureOut;
++
++void main(void)
++{
++	gl_Position = vertexIn;
++	textureOut = textureIn;
++}
