++void DebayerCpu::applySharpness(Span<uint8_t> output, float sharpness)
++{
++	if (sharpness <= 0.0f || outputSize_.width < 3 || outputSize_.height < 3)
++		return;
++
++	const unsigned int bytesPerPixel = outputConfig_.bpp / 8;
++	const unsigned int stride = outputConfig_.stride;
++	std::array<std::vector<uint8_t>, 3> lines;
++	for (unsigned int i = 0; i < lines.size(); ++i) {
++		lines[i].resize(stride);
++		memcpy(lines[i].data(), output.data() + i * stride, stride);
++	}
++
++	for (unsigned int y = 1; y + 1 < outputSize_.height; ++y) {
++		uint8_t *destination = output.data() + y * stride;
++		for (unsigned int x = 1; x + 1 < outputSize_.width; ++x) {
++			for (unsigned int channel = 0; channel < 3; ++channel) {
++				const unsigned int offset = x * bytesPerPixel + channel;
++				const int center = lines[1][offset];
++				const int blur =
++					(4 * center +
++					 lines[0][offset] + lines[2][offset] +
++					 lines[1][offset - bytesPerPixel] +
++					 lines[1][offset + bytesPerPixel] + 4) /
