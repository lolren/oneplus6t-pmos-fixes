++/* SPDX-License-Identifier: LGPL-2.1-or-later */
++/*
++ * Filtered RGB scaling pass for the EGL software ISP
++ */
++
++#ifdef GL_ES
++precision highp float;
++#endif
++
++varying vec2 textureOut;
++uniform sampler2D tex_rgb;
++
++void main(void)
++{
++	vec4 rgba = texture2D(tex_rgb, textureOut);
++
++#if defined(SWAP_BLUE)
++	gl_FragColor = rgba.bgra;
++#else
++	gl_FragColor = rgba;
++#endif
++}
+diff --git a/src/libcamera/shaders/rgb_scale.vert b/src/libcamera/shaders/rgb_scale.vert
+new file mode 100644
