++/* SPDX-License-Identifier: LGPL-2.1-or-later */
++/*
++ * Contrast-detect autofocus
++ */
++
++#include "af.h"
++
++#include <algorithm>
++#include <cmath>
++#include <errno.h>
++#include <limits>
++
++#include <linux/v4l2-controls.h>
