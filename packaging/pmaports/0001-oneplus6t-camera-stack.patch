++++ b/include/libcamera/internal/software_isp/swstats_cpu.h
+@@ -11,6 +11,7 @@
+ 
+ #pragma once
+ 
++#include <array>
+ #include <stdint.h>
+ #include <vector>
+ 
+@@ -67,7 +68,10 @@ public:
+ 		    y >= (window_.y + window_.height))
+ 			return;
