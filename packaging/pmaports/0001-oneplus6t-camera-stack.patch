+	$pkgname-echo-cancel:echo_cancel
+	$pkgname-openrc
+	$pkgname-systemd
+	$pkgname-udev
+	$pkgname-x11
+	$pkgname-filter-graph:filter_graph
+	$pkgname-filter-graph-builtin:filter_graph_plugin
+	$pkgname-filter-graph-ebur128:filter_graph_plugin
+	$pkgname-filter-graph-ladspa:filter_graph_plugin
+	$pkgname-filter-graph-lv2:filter_graph_plugin
+	$pkgname-filter-graph-sofa:filter_graph_plugin
+	$pkgname-snapcast
+	$pkgname-webrtc
+	$pkgname-rtp
+	"
+install="$pkgname.post-upgrade $pkgname.post-install"
+source="https://gitlab.freedesktop.org/PipeWire/pipewire/-/archive/$pkgver/pipewire-$pkgver.tar.gz
+	pipewire.desktop
+	pipewire-launcher.sh
+	pipewire.initd
+	pipewire-pulse.initd
+
+	systemd-units-wo-libsystemd.patch
