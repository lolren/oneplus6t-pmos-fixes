@@ -0,0 +1,16 @@
+#!/sbin/openrc-run
+
+description="PulseAudio compatibility layer for PipeWire"
+
+command="/usr/bin/pipewire-pulse"
+
+supervisor=supervise-daemon
+error_logger="logger -t '${RC_SVCNAME}' -p daemon.error"
+
+export PIPEWIRE_PULSE_NOTIFICATION_FD=3
+notify=fd:3
+
+depend() {
+	need pipewire
+	want wireplumber
+}
