++	factor = std::clamp(factor, 1.0f - kExpMaxStep,
++			    1.0f + kExpMaxStep);
++	if (std::abs(factor - 1.0f) < 0.0001f)
++		return;
+ 
+ 	if (factor > 1.0f) {
+ 		/* Scene too dark: increase exposure first, then gain. */
