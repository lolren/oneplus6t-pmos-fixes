@@ -0,0 +1,27 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Lolren <loren.bufanu@gmail.com>
+Date: Sun, 23 Aug 2026 15:46:58 +0100
+Subject: [PATCH 2/2] arm64: dts: qcom: sdm845-oneplus: add IMX371 binned link
+ rate
+
+The IMX371 2304x1728 binned mode uses a 399 MHz link frequency. Advertise
+it alongside the existing 654 MHz full-resolution frequency so the sensor
+driver can select either mode on the OnePlus 6 and 6T.
+
+Signed-off-by: Lolren <loren.bufanu@gmail.com>
+
+diff --git a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
+index 948a0dd18..ebee7e471 100644
+--- a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
++++ b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
+@@ -651,7 +651,7 @@ port {
+ 			imx371_ep: endpoint {
+ 				remote-endpoint = <&csiphy2_ep>;
+ 				data-lanes = <1 2 3 4>;
+-				link-frequencies = /bits/ 64 <654000000>;
++				link-frequencies = /bits/ 64 <654000000 399000000>;
+ 			};
+ 		};
+ 	};
+-- 
+2.49.0
diff --git a/device/community/linux-postmarketos-qcom-sdm845/0003-media-i2c-imx371-correct-analogue-gain-range.patch b/device/community/linux-postmarketos-qcom-sdm845/0003-media-i2c-imx371-correct-analogue-gain-range.patch
new file mode 100644
index 0000000000000000000000000000000000000000..fbaf3268affd0205ffcf3e528d50a00998eabf12
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sdm845/0003-media-i2c-imx371-correct-analogue-gain-range.patch
@@ -0,0 +1,27 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Lolren <loren.bufanu@gmail.com>
+Date: Sun, 23 Aug 2026 15:54:32 +0100
+Subject: [PATCH] media: i2c: imx371: correct analogue gain range
+
+The IMX371 analogue gain is 1024 / (1024 - code). A maximum code of 480
+limits the sensor to about 1.88x gain, while the supported 16x maximum
+maps to code 960. Use the full sensor range.
+
+Signed-off-by: Lolren <loren.bufanu@gmail.com>
+
+diff --git a/drivers/media/i2c/imx371.c b/drivers/media/i2c/imx371.c
+index bf28829af..062bb4f68 100644
+--- a/drivers/media/i2c/imx371.c
++++ b/drivers/media/i2c/imx371.c
+@@ -44,7 +44,7 @@
+ /* Analog gain control */
+ #define IMX371_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+ #define IMX371_ANA_GAIN_MIN		0
+-#define IMX371_ANA_GAIN_MAX		480
++#define IMX371_ANA_GAIN_MAX		960
+ #define IMX371_ANA_GAIN_STEP		1
+ #define IMX371_ANA_GAIN_DEFAULT		0x0
+ 
+-- 
+2.49.0
+
diff --git a/device/community/linux-postmarketos-qcom-sdm845/0004-media-i2c-imx376-correct-analogue-gain-range.patch b/device/community/linux-postmarketos-qcom-sdm845/0004-media-i2c-imx376-correct-analogue-gain-range.patch
new file mode 100644
index 0000000000000000000000000000000000000000..9cc55fdbf44c0f6437c9f44623aa9e7921fa40c1
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sdm845/0004-media-i2c-imx376-correct-analogue-gain-range.patch
@@ -0,0 +1,30 @@
+From 64fcf07f8a69b01488e524a7a0b2ba4b991111ee Mon Sep 17 00:00:00 2001
+From: Lolren <loren.bufanu@gmail.com>
+Date: Sun, 23 Aug 2026 17:35:49 +0100
+Subject: [PATCH] media: i2c: imx376: correct analogue gain range
+
+The IMX376 gain register at 0x0204 uses code = 1024 - 1024 / gain. The OnePlus OxygenOS sensor library clamps the requested gain to 16x and the resulting register code to 960.
+
+Raise the V4L2 control maximum from 480, which only exposes about 1.88x gain, to the sensor library limit of 960, which exposes the intended 16x range.
+
+Signed-off-by: Loren Bufanu <loren.bufanu@gmail.com>
+---
+ drivers/media/i2c/imx376.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/drivers/media/i2c/imx376.c b/drivers/media/i2c/imx376.c
+index 21d539878..656333524 100644
+--- a/drivers/media/i2c/imx376.c
++++ b/drivers/media/i2c/imx376.c
+@@ -42,7 +42,7 @@
+ /* Analog gain control */
+ #define IMX376_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+ #define IMX376_ANA_GAIN_MIN		0
+-#define IMX376_ANA_GAIN_MAX		480
++#define IMX376_ANA_GAIN_MAX		960
+ #define IMX376_ANA_GAIN_STEP		1
+ #define IMX376_ANA_GAIN_DEFAULT		0x0
+ 
+-- 
+2.49.0
+
