++bool Af::extendCoarsePositions()
++{
++	if (positions_.empty() || positionMetrics_.size() != positions_.size())
++		return false;
++
++	auto best = std::max_element(positionMetrics_.begin(),
++				     positionMetrics_.end());
++	const std::size_t bestIndex = best - positionMetrics_.begin();
++	auto [minimum, maximum] = std::minmax_element(positions_.begin(),
++						      positions_.end());
++	int32_t next;
++
++	if (positions_[bestIndex] == *minimum && *minimum > minPosition_)
++		next = std::max(minPosition_, *minimum - coarseStep_);
++	else if (positions_[bestIndex] == *maximum && *maximum < maxPosition_)
++		next = std::min(maxPosition_, *maximum + coarseStep_);
++	else
++		return false;
++
++	if (std::find(positions_.begin(), positions_.end(), next) !=
++	    positions_.end())
++		return false;
++
++	positions_.push_back(next);
++	return true;
+ }
