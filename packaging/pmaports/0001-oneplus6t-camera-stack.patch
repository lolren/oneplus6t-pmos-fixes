++			/* Hold steady inside the highlight hysteresis region. */
++			if (*highlightValue <=
++			    highlightTarget_ + kHighlightSatisfactory)
++				highlightFactor = 1.0;
++		} else {
++			/* Never let the predicted highlight exceed its target. */
++			highlightFactor = std::max(highlightFactor, 1.0);
++		}
