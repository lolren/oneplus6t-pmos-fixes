++/*
++ * Avoid reacting to tiny quantisation changes around the highlight target.
++ */
++static constexpr double kHighlightSatisfactory = 0.02;
++
++/*
++ * Return a black-level-normalised histogram quantile in the range [0, 1].
++ */
++static double normalizedQuantile(const SwIspStats::Histogram &histogram,
++				 unsigned int blackLevelHistIdx,
++				 double quantile)
++{
++	const auto first = histogram.begin() + blackLevelHistIdx;
++	const uint64_t total =
++		std::accumulate(first, histogram.end(), uint64_t(0));
++	if (!total)
++		return 0.0;
++
++	const double rank = quantile * total;
++	uint64_t cumulative = 0;
++	for (unsigned int i = blackLevelHistIdx; i < histogram.size(); i++) {
++		const uint64_t next = cumulative + histogram[i];
++		if (rank <= next) {
++			const double fraction = histogram[i]
++				? (rank - cumulative) / histogram[i]
++				: 0.0;
++			const double position = i + fraction - blackLevelHistIdx;
++			return std::clamp(position /
++					  (histogram.size() - blackLevelHistIdx),
++					  0.0, 1.0);
++		}
++
++		cumulative = next;
++	}
++
++	return 1.0;
++}
