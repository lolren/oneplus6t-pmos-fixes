+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Lolren <loren.bufanu@gmail.com>
+Date: Sun, 23 Aug 2026 15:46:58 +0100
+Subject: [PATCH 1/2] media: i2c: imx371: add 2304x1728 binned mode
+
+The IMX371 used by the OnePlus 6 and 6T has a Quad Bayer colour filter,
+but the driver currently exposes only its full-resolution readout as a
+regular Bayer frame. A conventional Bayer demosaic therefore produces a
+nearly monochrome image with a four-pixel grid.
+
+Add the sensor's 2x2 binned mode. It combines each physical same-colour
+2x2 block in hardware and outputs a conventional 2304x1728 RGGB frame.
+Include the matching line timing, PLL configuration and 399 MHz link
+frequency while retaining the full-resolution mode for raw users.
+
+Signed-off-by: Lolren <loren.bufanu@gmail.com>
+
+diff --git a/drivers/media/i2c/imx371.c b/drivers/media/i2c/imx371.c
+index c2a6ce243..bf28829af 100644
+--- a/drivers/media/i2c/imx371.c
++++ b/drivers/media/i2c/imx371.c
+@@ -26,10 +26,12 @@
+ 
+ /* V_TIMING internal */
+ #define IMX371_VTS_30FPS		3552
++#define IMX371_VTS_BINNED		2544
+ #define IMX371_VTS_MAX			65525
+ 
+ /* HBLANK control - read only */
+ #define IMX371_PPL_DEFAULT		6032
++#define IMX371_PPL_BINNED		3488
+ 
+ /* Exposure control */
+ #define IMX371_REG_EXPOSURE		CCI_REG16(0x0202)
+@@ -177,6 +179,21 @@ static const struct cci_reg_sequence mipi_1308mbps_24mhz_4l[] = {
+ 	{ IMX371_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
+ };
+ 
++static const struct cci_reg_sequence mipi_798mbps_24mhz_4l[] = {
++	{ IMX371_REG_EXCK_FREQ, 0x1800 },
++	{ IMX371_REG_IVTPXCK_DIV, 5 },
++	{ IMX371_REG_IVTSYCK_DIV, 4 },
++	{ IMX371_REG_PREPLLCK_VT_DIV, 4 },
++	{ IMX371_REG_PLL_IVT_MPY, 222 },
++	{ IMX371_REG_IOPSYCK_DIV, 2 },
++	{ IMX371_REG_PREPLLCK_OP_DIV, 4 },
++	{ IMX371_REG_PLL_IOP_MPY, 266 },
++	{ IMX371_REG_PLL_MULT_DRIV, 1 },
++	{ IMX371_REG_CSI_LANE_MODE, 3 },
++	{ IMX371_REG_REQ_LINK_BIT_RATE_MBPS_H, 798 * 4 },
++	{ IMX371_REG_REQ_LINK_BIT_RATE_MBPS_L, 0 },
++};
++
+ static const struct cci_reg_sequence mode_common_regs[] = {
+ 	{CCI_REG8(0x3C7D), 0x28},
+ 	{CCI_REG8(0x3C7E), 0x01},
+@@ -412,6 +429,98 @@ static const struct cci_reg_sequence mode_4656x3496_regs[] = {
+ 	{CCI_REG8(0x020F), 0x00},
+ };
